~~~ file: PoolMenu.svelte
<!--
  PoolMenu.svelte: a button that opens a little menu of actions!

  <PoolMenu label="Lane options" items={[
    { label: 'Book this lane', onselect: book },
    { label: 'Share', onselect: share },
    { separator: true },
    { label: 'Cancel booking', onselect: cancel, danger: true }
  ]} />

  Props: label (the button's text), items ([{ label, onselect, disabled, danger } or { separator: true }]), tone (the button:
         'ghost' default, 'water', 'orange'), align ('left' default or 'right'), class.
  Keyboard: Enter or Down opens it, arrows move, Home/End jump, Enter picks, Escape closes and goes back to the button.
-->
<script>
    import PoolButton from './PoolButton.svelte';
    let { label = 'Menu', items = [], tone = 'ghost', align = 'left', class: className = '' } = $props();
    let open = $state(false);
    let wrap = $state(), list = $state();
    const uid = 'plm' + Math.random().toString(36).slice(2, 8);
    const entries = () => (list ? Array.from(list.querySelectorAll('[role="menuitem"]:not([aria-disabled="true"])')) : []);
    function show(focusLast) {
        open = true;
        requestAnimationFrame(() => { const e = entries(); (focusLast ? e[e.length - 1] : e[0])?.focus(); });
    }
    function hide(back) { open = false; if (back) wrap?.querySelector('.pool-menu-btn')?.focus(); }
    function pick(it) { if (it.disabled) return; hide(true); if (typeof it.onselect === 'function') it.onselect(); }
    function btnKeys(e) {
        if (e.key === 'ArrowDown' || e.key === 'Enter' || e.key === ' ') { e.preventDefault(); show(false); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); show(true); }
    }
    function listKeys(e) {
        const all = entries(), i = all.indexOf(document.activeElement);
        if (e.key === 'ArrowDown') { e.preventDefault(); all[(i + 1) % all.length]?.focus(); }
        else if (e.key === 'ArrowUp') { e.preventDefault(); all[(i - 1 + all.length) % all.length]?.focus(); }
        else if (e.key === 'Home') { e.preventDefault(); all[0]?.focus(); }
        else if (e.key === 'End') { e.preventDefault(); all[all.length - 1]?.focus(); }
        else if (e.key === 'Escape') { e.preventDefault(); hide(true); }
        else if (e.key === 'Tab') hide(false);
    }
    $effect(() => {
        if (!open) return;
        const away = (e) => { if (wrap && !wrap.contains(e.target)) hide(false); };
        document.addEventListener('pointerdown', away);
        return () => document.removeEventListener('pointerdown', away);
    });
</script>

<span class="pool-menu {className}" bind:this={wrap}>
    <span class="pool-menu-btn-wrap" role="presentation" onkeydown={btnKeys}>
        <PoolButton {tone} class="pool-menu-btn" aria-haspopup="menu" aria-expanded={open} aria-controls={uid} onclick={() => (open ? hide(false) : show(false))}>
            {label}<svg class="pool-menu-chev" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
        </PoolButton>
    </span>
    {#if open}
        <div class="pool-menu-list pool-{align}" role="menu" id={uid} aria-label={label} tabindex="-1" bind:this={list} onkeydown={listKeys}>
            {#each items as it, i (i)}
                {#if it.separator}<div class="pool-menu-sep" role="separator"></div>
                {:else}<div class="pool-menu-item" class:danger={it.danger} role="menuitem" tabindex="-1" aria-disabled={it.disabled ? 'true' : undefined} onclick={() => pick(it)} onkeydown={(e) => { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); pick(it); } }}>{it.label}</div>{/if}
            {/each}
        </div>
    {/if}
</span>

<style>
    .pool-menu { position: relative; display: inline-block; font-family: var(--pool-font, system-ui, sans-serif); }
    .pool-menu-chev { fill: none; stroke: var(--pool-orange, #f97316); stroke-width: 2.8; stroke-linecap: round; stroke-linejoin: round; margin-left: 2px; }
    .pool-menu-list { position: absolute; top: calc(100% + 6px); z-index: 60; min-width: 200px; padding: 6px; border-radius: 14px; outline: none;
        background: #fff; border: 1px solid var(--pool-line, rgba(14, 165, 233, 0.4)); box-shadow: inset 0 3px 0 var(--pool-orange, #f97316), 0 12px 28px rgba(7, 89, 133, 0.25); }
    .pool-left { left: 0; }
    .pool-right { right: 0; }
    .pool-menu-item { padding: 8px 12px; border-radius: 9px; cursor: pointer; font: 600 14px var(--pool-font, system-ui, sans-serif); color: var(--pool-ink, #0c4a6e); outline: none; }
    .pool-menu-item:hover, .pool-menu-item:focus { color: var(--pool-deep, #075985); background: var(--pool-water-soft, #d6f4fc); }
    .pool-menu-item:focus-visible { box-shadow: inset 4px 0 0 var(--pool-orange, #f97316); }
    .danger { color: var(--pool-orange-deep, #c2410c); }
    .danger:hover, .danger:focus { color: var(--pool-orange-deep, #c2410c); background: var(--pool-orange-soft, #ffe9d6); }
    [aria-disabled='true'] { opacity: 0.45; cursor: not-allowed; }
    [aria-disabled='true']:hover { background: none; color: var(--pool-ink, #0c4a6e); text-shadow: none; }
    .pool-menu-sep { height: 1px; margin: 5px 6px; background: var(--pool-line, rgba(14, 165, 233, 0.4)); }
</style>
