~~~ file: PoolDialog.svelte
<!--
  PoolDialog.svelte: a pop-up window with a water header and an orange stripe, on a soft blue haze!

  <PoolButton onclick={() => (open = true)}>Book a lane</PoolButton>
  <PoolDialog bind:open title="Book a lane">
    Which lane would you like?
    {#snippet footer()}
      <PoolButton tone="ghost" onclick={() => (open = false)}>Cancel</PoolButton>
      <PoolButton onclick={book}>Book it!</PoolButton>
    {/snippet}
  </PoolDialog>

  Props: open (bindable), title, width (default '440px'), closeOnBackdrop (true), onclose(), children, footer (snippet), class.
  It uses the browser's own <dialog> (showModal), so focus stays inside it and Escape closes it.
-->
<script>
    let { open = $bindable(false), title = '', width = '440px', closeOnBackdrop = true, onclose = undefined, children = undefined, footer = undefined, class: className = '' } = $props();
    let dlg = $state();
    const uid = 'pld' + Math.random().toString(36).slice(2, 8);
    $effect(() => {
        if (!dlg) return;
        if (open && !dlg.open) dlg.showModal();
        else if (!open && dlg.open) dlg.close();
    });
    function closed() { open = false; if (typeof onclose === 'function') onclose(); }
    function backdrop(e) { if (closeOnBackdrop && e.target === dlg) dlg.close(); }
</script>

<dialog bind:this={dlg} class="pool-dialog {className}" style:--pd-w={width} aria-labelledby={title ? uid : undefined} onclose={closed} onclick={backdrop}>
    <div class="pool-dialog-box">
        <header class="pool-dialog-head">
            <h2 id={uid}>{title}</h2>
            <button type="button" class="pool-dialog-x" aria-label="Close" onclick={() => dlg.close()}><svg viewBox="0 0 12 12" width="12" height="12" aria-hidden="true"><path d="M2.5 2.5l7 7M9.5 2.5l-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg></button>
        </header>
        <div class="pool-dialog-body">{#if children}{@render children()}{/if}</div>
        {#if footer}<footer class="pool-dialog-foot">{@render footer()}</footer>{/if}
    </div>
</dialog>

<style>
    .pool-dialog { width: min(var(--pd-w), calc(100vw - 24px)); padding: 0; border: 0; border-radius: var(--pool-radius, 16px); background: none; color: var(--pool-ink, #0c4a6e); font-family: var(--pool-font, system-ui, sans-serif); overflow: visible; }
    .pool-dialog::backdrop { background: radial-gradient(circle at 50% 30%, rgba(103, 232, 249, 0.35), rgba(7, 89, 133, 0.45)); backdrop-filter: blur(3px); }
    .pool-dialog[open] { animation: pool-pop 0.18s ease-out; }
    @keyframes pool-pop { from { transform: translateY(8px) scale(0.98); opacity: 0; } }
    .pool-dialog-box { border-radius: var(--pool-radius, 16px); overflow: hidden; background: var(--pool-tile, #f0fdff); border: 1px solid var(--pool-line, rgba(14, 165, 233, 0.4)); box-shadow: 0 24px 60px rgba(7, 89, 133, 0.35); }
    .pool-dialog-head { display: flex; align-items: center; gap: 10px; padding: 12px 14px 12px 18px; color: #fff; text-shadow: 0 1px 2px rgba(7, 89, 133, 0.5);
        background: radial-gradient(120% 60% at 20% 0%, rgba(255, 255, 255, 0.5), transparent 60%), repeating-radial-gradient(circle at 85% 150%, rgba(255, 255, 255, 0.14) 0 6px, transparent 6px 14px), linear-gradient(180deg, var(--pool-water-1, #67e8f9), var(--pool-water-3, #00b2e3));
        box-shadow: inset 0 -4px 0 var(--pool-orange, #f97316); }
    h2 { flex: 1; margin: 0; font-size: 17px; font-weight: 800; }
    .pool-dialog-x { display: inline-flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 50%; border: 1px solid rgba(255, 255, 255, 0.6); background: rgba(255, 255, 255, 0.2); color: #fff; cursor: pointer; }
    .pool-dialog-x:hover { background: rgba(255, 255, 255, 0.4); }
    .pool-dialog-x:focus-visible { outline: 3px solid var(--pool-orange, #f97316); outline-offset: 1px; }
    .pool-dialog-body { padding: 16px 18px; line-height: 1.5; }
    .pool-dialog-foot { display: flex; gap: 8px; justify-content: flex-end; padding: 10px 14px; border-top: 1px solid var(--pool-line, rgba(14, 165, 233, 0.4)); background: rgba(255, 255, 255, 0.85); }
    @media (prefers-reduced-motion: reduce) { .pool-dialog[open] { animation: none; } }
</style>
