~~~ file: PoolSegmented.svelte
<!--
  PoolSegmented.svelte: a row of joined buttons where a water bubble slides to the one you pick!

  <PoolSegmented options={['Day', 'Week', 'Month']} bind:value={range} />
  <PoolSegmented options={[{ value: 'c', label: '°C' }, { value: 'f', label: '°F' }]} bind:value size="small" label="Units" />

  Props: options (strings, or { value, label }), value (bindable), label (a name for screen readers), size ('small' | 'medium'),
         onchange(value), class. Arrow keys move the choice, like radio buttons.
-->
<script>
    let { options = [], value = $bindable(undefined), label = 'Choose one', size = 'medium', onchange = undefined, class: className = '' } = $props();
    const opts = $derived(options.map((o) => (typeof o === 'object' && o ? o : { value: o, label: String(o) })));
    const idx = $derived(Math.max(0, opts.findIndex((o) => o.value === value)));
    let row = $state();
    $effect(() => { if (value === undefined && opts.length) value = opts[0].value; });
    function pick(i, focus) {
        const o = opts[(i + opts.length) % opts.length];
        value = o.value;
        if (typeof onchange === 'function') onchange(o.value);
        if (focus && row) row.querySelectorAll('button')[(i + opts.length) % opts.length]?.focus();
    }
    function keys(e) {
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') { e.preventDefault(); pick(idx + 1, true); }
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') { e.preventDefault(); pick(idx - 1, true); }
    }
</script>

<div class="pool-seg pool-{size} {className}" role="radiogroup" aria-label={label} bind:this={row} tabindex="-1" onkeydown={keys} style:--n={opts.length} style:--i={idx}>
    <span class="pool-bubble" aria-hidden="true"></span>
    {#each opts as o, i (o.value)}
        <button type="button" role="radio" aria-checked={i === idx} tabindex={i === idx ? 0 : -1} onclick={() => pick(i)}>{o.label}</button>
    {/each}
</div>

<style>
    .pool-seg { position: relative; display: inline-grid; grid-template-columns: repeat(var(--n), 1fr); padding: 3px; border-radius: 999px; border: 1px solid var(--pool-line, rgba(14, 165, 233, 0.4));
        background: var(--pool-water-soft, #d6f4fc); font-family: var(--pool-font, system-ui, sans-serif); }
    .pool-bubble { position: absolute; top: 3px; bottom: 3px; left: 3px; width: calc((100% - 6px) / var(--n)); transform: translateX(calc(100% * var(--i))); border-radius: 999px; transition: transform 0.25s cubic-bezier(.3, 1.3, .5, 1);
        box-sizing: border-box; background: #fff; border: 2px solid var(--pool-water-3, #00b2e3); }
    button { position: relative; z-index: 1; border: 0; background: none; cursor: pointer; border-radius: 999px; padding: 7px 18px; font: 700 14px var(--pool-font, system-ui, sans-serif); color: var(--pool-deep, #075985); white-space: nowrap; transition: color 0.2s; }
    .pool-small button { padding: 4px 12px; font-size: 12.5px; }
    button[aria-checked='true'] { color: var(--pool-deep, #075985); }
    button:focus-visible { outline: 3px solid var(--pool-orange, #f97316); outline-offset: 1px; }
    @media (prefers-reduced-motion: reduce) { .pool-bubble, button { transition: none; } }
</style>
~~~

~~~ file: PoolSelect.svelte
<!--
  PoolSelect.svelte: a drop-down that matches PoolInput, with an orange arrow!

  <PoolSelect label="Pool" options={['Main pool', 'Kids pool', 'Diving pool']} bind:value={pool} />
  <PoolSelect label="Time" options={[{ value: 9, label: '9:00' }, { value: 10, label: '10:00' }]} bind:value placeholder="Pick a time" />

  Props: options (strings, or { value, label, disabled }), value (bindable), label, placeholder (an empty first choice), hint, error,
         disabled, required, onchange(value), class. It is the browser's own <select>, so it works everywhere, phones included.
-->
<script>
    let { options = [], value = $bindable(undefined), label = '', placeholder = '', hint = '', error = '', disabled = false, required = false, onchange = undefined, class: className = '' } = $props();
    const uid = 'plsel' + Math.random().toString(36).slice(2, 8);
    const opts = $derived(options.map((o) => (typeof o === 'object' && o ? o : { value: o, label: String(o) })));
    const said = $derived([hint && !error ? uid + '-h' : '', error ? uid + '-e' : ''].filter(Boolean).join(' ') || undefined);
</script>

<div class="pool-field {className}" class:bad={!!error} class:off-limits={disabled}>
    {#if label}<label for={uid}>{label}</label>{/if}
    <div class="pool-select">
        <select id={uid} bind:value {disabled} {required} aria-invalid={error ? 'true' : undefined} aria-describedby={said} onchange={() => { if (typeof onchange === 'function') onchange(value); }}>
            {#if placeholder}<option value={undefined} disabled selected={value === undefined}>{placeholder}</option>{/if}
            {#each opts as o (o.value)}<option value={o.value} disabled={o.disabled}>{o.label}</option>{/each}
        </select>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
    </div>
    {#if hint && !error}<small id={uid + '-h'} class="pool-hint">{hint}</small>{/if}
    {#if error}<small id={uid + '-e'} class="pool-error" role="alert">{error}</small>{/if}
</div>

<style>
    .pool-field { display: flex; flex-direction: column; gap: 5px; font-family: var(--pool-font, system-ui, sans-serif); color: var(--pool-ink, #0c4a6e); }
    label { font: 700 13px var(--pool-font, system-ui, sans-serif); color: var(--pool-deep, #075985); }
    .pool-select { position: relative; }
    select { -webkit-appearance: none; appearance: none; box-sizing: border-box; width: 100%; font: 15px var(--pool-font, system-ui, sans-serif); color: var(--pool-ink, #0c4a6e); padding: 10px 40px 10px 14px; border-radius: 12px; cursor: pointer;
        border: 1px solid var(--pool-line, rgba(14, 165, 233, 0.4)); background: linear-gradient(180deg, #ffffff, var(--pool-tile, #f0fdff)); box-shadow: inset 0 2px 3px rgba(7, 89, 133, 0.08); }
    select:focus { outline: none; border-color: var(--pool-water-3, #00b2e3); box-shadow: 0 0 0 4px rgba(34, 211, 238, 0.35); }
    svg { position: absolute; right: 12px; top: 50%; width: 18px; height: 18px; margin-top: -9px; pointer-events: none; fill: none; stroke: var(--pool-orange, #f97316); stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
    .bad select { border-color: var(--pool-orange, #f97316); box-shadow: inset 4px 0 0 var(--pool-orange, #f97316); }
    .pool-hint { color: #4b7a94; font-size: 12.5px; }
    .pool-error { color: var(--pool-orange-deep, #c2410c); font-size: 12.5px; font-weight: 700; }
    .off-limits { opacity: 0.55; }
</style>
~~~

~~~ file: PoolSkeleton.svelte
<!--
  PoolSkeleton.svelte: a stand-in shape while something loads, with light rippling across it like sun on water!

  <PoolSkeleton lines={3} />                         (three text lines, the last one shorter)
  <PoolSkeleton shape="circle" width="48px" />
  <PoolSkeleton shape="block" height="140px" />

  Props: shape ('text' default, 'circle', 'block'), lines (for text, default 1), width, height, label (for screen readers,
         default 'Loading'), class. It holds still when reduced motion is on.
-->
<script>
    let { shape = 'text', lines = 1, width = undefined, height = undefined, label = 'Loading', class: className = '' } = $props();
</script>

<span class="pool-skel-wrap {className}" role="status" aria-label={label}>
    {#if shape === 'text'}
        {#each Array.from({ length: Math.max(1, lines) }) as _, i (i)}
            <span class="pool-skel pool-line" style:width={i === lines - 1 && lines > 1 ? '62%' : width || '100%'} aria-hidden="true"></span>
        {/each}
    {:else}
        <span class="pool-skel pool-{shape}" style:width={width || (shape === 'circle' ? '40px' : '100%')} style:height={height || (shape === 'circle' ? width || '40px' : '120px')} aria-hidden="true"></span>
    {/if}
</span>

<style>
    .pool-skel-wrap { display: flex; flex-direction: column; gap: 8px; }
    .pool-skel { display: block; position: relative; overflow: hidden; background: #cffafe; }
    .pool-skel::after { content: ''; position: absolute; inset: 0; transform: translateX(-100%); animation: pool-shine 1.6s ease-in-out infinite;
        background: linear-gradient(100deg, transparent 20%, rgba(255, 255, 255, 0.85) 50%, transparent 80%); }
    .pool-line { height: 12px; border-radius: 999px; }
    .pool-circle { border-radius: 50%; flex: none; }
    .pool-block { border-radius: 14px; }
    @keyframes pool-shine { to { transform: translateX(100%); } }
    @media (prefers-reduced-motion: reduce) { .pool-skel::after { animation: none; display: none; } }
</style>
~~~

~~~ file: PoolSlider.svelte
<!--
  PoolSlider.svelte: a slider whose track fills with water up to an orange float!

  <PoolSlider bind:value={temp} min={20} max={34} step={0.5} label="Water temperature" unit="°C" />

  Props: value (bindable), min (0), max (100), step (1), label, unit (shown after the number), showValue (true),
         disabled, oninput(value), class. It is a real range input, so arrow keys, Page Up/Down, Home and End work.
-->
<script>
    let { value = $bindable(50), min = 0, max = 100, step = 1, label = '', unit = '', showValue = true, disabled = false, oninput = undefined, class: className = '' } = $props();
    const uid = 'pls' + Math.random().toString(36).slice(2, 8);
    const pct = $derived(max > min ? Math.min(100, Math.max(0, ((value - min) / (max - min)) * 100)) : 0);
</script>

<div class="pool-slider {className}" class:off-limits={disabled}>
    {#if label || showValue}
        <div class="pool-slider-top">
            {#if label}<label for={uid}>{label}</label>{/if}
            {#if showValue}<output for={uid}>{value}{unit}</output>{/if}
        </div>
    {/if}
    <input id={uid} type="range" {min} {max} {step} {disabled} bind:value style:--pct={pct + '%'} oninput={() => { if (typeof oninput === 'function') oninput(value); }} aria-valuetext={value + (unit || '')} />
</div>

<style>
    .pool-slider { font: 600 14px var(--pool-font, system-ui, sans-serif); color: var(--pool-ink, #0c4a6e); min-width: 160px; }
    .off-limits { opacity: 0.5; }
    .pool-slider-top { display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 4px; }
    output { font-variant-numeric: tabular-nums; color: var(--pool-deep, #075985); font-weight: 800; }
    input { -webkit-appearance: none; appearance: none; width: 100%; height: 26px; margin: 0; background: none; cursor: pointer; }
    input:disabled { cursor: not-allowed; }
    input::-webkit-slider-runnable-track { height: 12px; border-radius: 999px; border: 1px solid var(--pool-line, rgba(14, 165, 233, 0.4));
        background: linear-gradient(90deg, var(--pool-water-2, #22d3ee) 0, var(--pool-water-3, #00b2e3) var(--pct), var(--pool-tile, #f0fdff) var(--pct)); box-shadow: inset 0 1px 2px rgba(7, 89, 133, 0.25); }
    input::-moz-range-track { height: 12px; border-radius: 999px; border: 1px solid var(--pool-line, rgba(14, 165, 233, 0.4)); background: var(--pool-tile, #f0fdff); }
    input::-moz-range-progress { height: 12px; border-radius: 999px; background: linear-gradient(90deg, var(--pool-water-2, #22d3ee), var(--pool-water-3, #00b2e3)); }
    /* the thumb is an orange float with a white band and a shine */
    input::-webkit-slider-thumb { -webkit-appearance: none; width: 24px; height: 24px; margin-top: -7px; border-radius: 50%; border: 2px solid #fff;
        background: radial-gradient(circle at 35% 30%, rgba(255, 255, 255, 0.85), transparent 40%), linear-gradient(180deg, var(--pool-orange, #f97316) 0 40%, #fff 40% 60%, var(--pool-orange, #f97316) 60%);
        box-shadow: 0 2px 6px rgba(124, 45, 18, 0.4); }
    input::-moz-range-thumb { width: 22px; height: 22px; border-radius: 50%; border: 2px solid #fff;
        background: radial-gradient(circle at 35% 30%, rgba(255, 255, 255, 0.85), transparent 40%), linear-gradient(180deg, var(--pool-orange, #f97316) 0 40%, #fff 40% 60%, var(--pool-orange, #f97316) 60%); box-shadow: 0 2px 6px rgba(124, 45, 18, 0.4); }
    input:focus-visible { outline: none; }
    input:focus-visible::-webkit-slider-thumb { box-shadow: 0 0 0 4px rgba(249, 115, 22, 0.45), 0 2px 6px rgba(124, 45, 18, 0.4); }
    input:focus-visible::-moz-range-thumb { box-shadow: 0 0 0 4px rgba(249, 115, 22, 0.45); }
</style>
~~~

~~~ file: PoolSpinner.svelte
<!--
  PoolSpinner.svelte: a spinning life ring for "loading"!

  <PoolSpinner />
  <PoolSpinner size="48px" label="Loading the lanes" showLabel />

  Props: size (default '28px'), label (what is loading, for screen readers; default 'Loading'), showLabel (also show it), class.
  With reduced motion it pulses gently instead of spinning.
-->
<script>
    let { size = '28px', label = 'Loading', showLabel = false, class: className = '' } = $props();
</script>

<span class="pool-spin {className}" role="status" style:--ps={size}>
    <span class="pool-spin-ring" aria-hidden="true"></span>
    {#if showLabel}<span class="pool-spin-label">{label}…</span>{:else}<span class="pool-sr">{label}</span>{/if}
</span>

<style>
    .pool-spin { display: inline-flex; align-items: center; gap: 8px; font: 600 14px var(--pool-font, system-ui, sans-serif); color: var(--pool-deep, #075985); vertical-align: middle; }
    .pool-spin-ring { width: var(--ps); height: var(--ps); border-radius: 50%; flex: none; animation: pool-spin 1s linear infinite;
        background: radial-gradient(circle at 35% 25%, rgba(255, 255, 255, 0.85), transparent 35%),
            conic-gradient(var(--pool-orange, #f97316) 0 45deg, #fff 45deg 90deg, var(--pool-orange, #f97316) 90deg 135deg, #fff 135deg 180deg, var(--pool-orange, #f97316) 180deg 225deg, #fff 225deg 270deg, var(--pool-orange, #f97316) 270deg 315deg, #fff 315deg);
        -webkit-mask: radial-gradient(circle, transparent 0 38%, #000 40%); mask: radial-gradient(circle, transparent 0 38%, #000 40%);
        filter: drop-shadow(0 1px 2px rgba(7, 89, 133, 0.45)); }
    @keyframes pool-spin { to { transform: rotate(360deg); } }
    .pool-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    @media (prefers-reduced-motion: reduce) { .pool-spin-ring { animation: pool-pulse 1.6s ease-in-out infinite alternate; } @keyframes pool-pulse { to { opacity: 0.45; } } }
</style>
