**PoolsideUI** is a set of twenty-six **Svelte 5** components in the Poolside style: clear water from cyan to blue, with orange as a crisp accent (stripes, edges, life rings, lane ropes), never blended into the water. This one lite holds all of it: every `Pool*.svelte` component, `index.js` (one import for everything), `poolside.css` (the design tokens, optional because every component has them built in) and `App.svelte`, a demo page that shows every component. Press **Start** in the preview and it is compiled right in your browser!

Use it in your own project by downloading the ZIP, then `import { PoolButton, PoolCard, toast } from './PoolsideUI/index.js'`. Everything works with the keyboard and screen readers, and the animations stop when the system asks for reduced motion. The README below lists what each component does.

~~~ file: App.svelte
<script>
    import { PoolButton, PoolCard, PoolToggle, PoolSlider, PoolProgress, PoolTabs, PoolInput, PoolChip, PoolDialog, PoolToaster, toast, PoolAccordion, PoolTiles,
        PoolCheckbox, PoolRadioGroup, PoolSelect, PoolSegmented, PoolAlert, PoolSpinner, PoolSkeleton, PoolTooltip, PoolAvatar, PoolMenu, PoolStepper, PoolPagination, PoolTable, PoolStat } from './index.js';

    let heated = $state(true), slide = $state(false);
    let temp = $state(27.5), level = $state(64);
    let lane = $state(0);
    let name = $state(''), email = $state(''), notes = $state('');
    const emailBad = $derived(email && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email));
    let tags = $state(['Heated', 'Kids pool', 'Diving board', 'Sun loungers']);
    let open = $state(false);
    let faqOpen = $state([0]);
    const RING = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3.5"/><path d="M12 4v4.5M12 15.5V20M4 12h4.5M15.5 12H20"/></svg>';
    const SUN = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><circle cx="12" cy="12" r="4"/><path d="M12 3v2M12 19v2M3 12h2M19 12h2M5.6 5.6l1.4 1.4M17 17l1.4 1.4M5.6 18.4L7 17M17 7l1.4-1.4"/></svg>';
    let rules = $state(false), towels = $state(true), goggles = $state(false);
    const allExtras = $derived(towels && goggles), someExtras = $derived(towels !== goggles);
    let speed = $state('Medium'), pool = $state(undefined), range = $state('Week');
    let alertOpen = $state(true), loading = $state(true);
    let step = $state(1), page = $state(4);
    let sortBy = $state('time'), sortDir = $state('asc');
    let picked = $state('');
    const RESULTS = [{ name: 'Marina Costa', lane: 4, time: 58.21, club: 'Dolphins' }, { name: 'Kai Lindqvist', lane: 5, time: 57.94, club: 'Sharks' }, { name: 'Ana Ruiz', lane: 3, time: 59.02, club: 'Otters' }, { name: 'Tomás Reyes', lane: 6, time: 58.67, club: 'Dolphins' }, { name: 'Zoe Park', lane: 2, time: 60.15, club: 'Seals' }];
    const CODE = {
        button: '<PoolButton onclick={save}>Save</PoolButton>\n<PoolButton tone="orange">Dive in!</PoolButton>\n<PoolButton tone="ghost" size="small">Pool rules</PoolButton>',
        card: '<PoolCard title="Pool party" subtitle="Saturday" icon={ringSvg}>\n    Bring a towel!\n    {#snippet footer()}<PoolButton size="small">I\'m coming!</PoolButton>{/snippet}\n</PoolCard>',
        toggle: '<PoolToggle bind:checked={heated} label="Heated pool" />\n<PoolSlider bind:value={temp} min={20} max={34} step={0.5} label="Water temperature" unit="°C" />',
        progress: '<PoolProgress value={level} label="Filling the pool" />\n<PoolProgress value={level} shape="round" label="Water level" />\n<PoolProgress label="Waiting…" />',
        tabs: '<PoolTabs tabs={["Lap swim", "Lessons", "Free swim"]} bind:active>\n    {#snippet panel(i)}…{/snippet}\n</PoolTabs>',
        input: '<PoolInput label="Email" type="email" bind:value={email} error={bad ? "That email looks unfinished!" : ""} />',
        chip: '<PoolChip>Heated</PoolChip>\n<PoolChip tone="orange">Lifeguard on duty</PoolChip>\n<PoolChip tone="soft" onremove={() => drop(tag)}>{tag}</PoolChip>',
        dialog: '<PoolDialog bind:open title="Book a lane">…{#snippet footer()}…{/snippet}</PoolDialog>\n\n<PoolToaster />   then anywhere:   toast("Saved!")',
        acc: '<PoolAccordion items={[{ title: "Do I need a swim cap?", text: "Only in the lap lanes!" }]} bind:open />',
        tiles: '<PoolTiles depth="deep">\n    <h2>Summer hours</h2> …\n</PoolTiles>',
        check: '<PoolCheckbox bind:checked={rules}>I read the pool rules</PoolCheckbox>\n<PoolRadioGroup label="Lane speed" options={["Slow", "Medium", "Fast"]} bind:value={speed} row />\n<PoolSelect label="Pool" options={pools} bind:value={pool} placeholder="Pick a pool" />\n<PoolSegmented options={["Day", "Week", "Month"]} bind:value={range} />',
        alert: '<PoolAlert title="Pool closes early">Today at 6!</PoolAlert>\n<PoolAlert tone="warning" title="No running!" dismissible bind:open>…</PoolAlert>',
        loading: '<PoolSpinner label="Loading the lanes" showLabel />\n<PoolSkeleton shape="circle" width="48px" />  <PoolSkeleton lines={3} />',
        people: '<PoolAvatar name="Marina Costa" status="online" />\n<PoolTooltip tip="Lane 1 is the fast lane"><PoolButton>Lane 1</PoolButton></PoolTooltip>\n<PoolMenu label="Lane options" items={[{ label: "Book", onselect: book }, { separator: true }, { label: "Cancel", danger: true, onselect: cancel }]} />',
        steps: '<PoolStepper steps={["Pick a lane", "Choose a time", "Pay", "Swim!"]} bind:current={step} />\n<PoolPagination bind:page total={12} />',
        table: '<PoolTable caption="100 m freestyle" columns={[{ key: "name", label: "Swimmer" }, { key: "time", label: "Time (s)", align: "right", format: (v) => v.toFixed(2) }]} rows={results} bind:sortBy bind:sortDir />\n<PoolStat label="Swimmers today" value={312} change={8.4} trend={[240, 260, 255, 290, 312]} />'
    };
</script>

<PoolToaster />

<div class="demo">
    <PoolTiles padding="36px 28px">
        <h1>PoolsideUI</h1>
        <p class="lead">Twenty-six Svelte 5 components in the Poolside style: clear water from cyan to blue, with orange as a crisp accent! Everything works with the keyboard and screen readers, and holds still when motion is turned off.</p>
        <div class="row"><PoolButton size="large" onclick={() => toast('Welcome to the pool!')}>Make a splash</PoolButton><PoolButton size="large" tone="orange" onclick={() => toast('Lifeguard is on the way!', { tone: 'orange' })}>Call the lifeguard</PoolButton></div>
    </PoolTiles>

    <section><h2>PoolButton</h2><p>Flat water, an orange life-ring tone and a white ghost one! Each press sends out a ripple!</p>
        <div class="row"><PoolButton>Water</PoolButton><PoolButton tone="orange">Orange</PoolButton><PoolButton tone="ghost">Ghost</PoolButton><PoolButton size="small">Small</PoolButton><PoolButton disabled>Disabled</PoolButton><PoolButton tone="ghost" href="#card">A link</PoolButton></div>
        <pre>{CODE.button}</pre></section>

    <section id="card"><h2>PoolCard</h2><p>White tiles under a rippling water header, with an orange stripe and an icon in a life ring!</p>
        <div class="grid">
            <PoolCard title="Pool party" subtitle="Saturday at noon" icon={RING}>Bring a towel and your best <b>cannonball</b>!{#snippet footer()}<PoolButton size="small" tone="ghost">Maybe</PoolButton><PoolButton size="small">I'm coming!</PoolButton>{/snippet}</PoolCard>
            <PoolCard title="Sun index" subtitle="Today" icon={SUN}>Strong sun from 11 to 3, so sunscreen up!</PoolCard>
            <PoolCard flat>A flat card has no header, just the tiles and the orange stripe!</PoolCard>
        </div>
        <pre>{CODE.card}</pre></section>

    <section><h2>PoolToggle and PoolSlider</h2><p>The switch knob is a life ring that floats across, and the slider fills with water up to an orange float!</p>
        <div class="row"><PoolToggle bind:checked={heated} label="Heated pool" /><PoolToggle bind:checked={slide} label="Water slide open" /><PoolToggle checked disabled label="Disabled" /></div>
        <div class="grid"><PoolSlider bind:value={temp} min={20} max={34} step={0.5} label="Water temperature" unit="°C" /><PoolSlider bind:value={level} label="Water level" unit="%" /></div>
        <p class="note">The pool is {heated ? 'heated' : 'not heated'} to <b>{temp}°C</b>, and the slide is {slide ? 'open' : 'closed'}!</p>
        <pre>{CODE.toggle}</pre></section>

    <section><h2>PoolProgress</h2><p>Progress as a water level, as a bar or a round porthole with waves on top! Move the Water level slider above!</p>
        <div class="grid"><div class="stack"><PoolProgress value={level} label="Filling the pool" /><PoolProgress label="Waiting for the lifeguard…" /></div>
            <div class="row"><PoolProgress value={level} shape="round" label="Water level" /><PoolProgress shape="round" size="72px" label="Busy" /></div></div>
        <pre>{CODE.progress}</pre></section>

    <section><h2>PoolTabs</h2><p>Swimming lanes split by orange-and-white lane ropes! Arrow keys move between them!</p>
        <PoolTabs tabs={['Lap swim', 'Lessons', 'Free swim']} bind:active={lane}>
            {#snippet panel(i)}
                {#if i === 0}Lap lanes are open <b>6 to 9</b> every morning, fast lane on the left!{:else if i === 1}Lessons for all ages on <b>Saturdays</b>, from Tadpoles to Sharks!{:else}Free swim every afternoon, with the slide open from <b>2</b>!{/if}
            {/snippet}
        </PoolTabs>
        <pre>{CODE.tabs}</pre></section>

    <section><h2>PoolInput</h2><p>Fields like clean tiles, a water-blue focus ring, and orange when something needs fixing!</p>
        <div class="grid"><PoolInput label="Your name" bind:value={name} placeholder="Marina" required hint="The name on your pool pass" />
            <PoolInput label="Email" type="email" bind:value={email} placeholder="marina@example.com" error={emailBad ? 'That email looks unfinished!' : ''} />
            <PoolInput label="Notes for the lifeguard" multiline rows={3} bind:value={notes} /></div>
        <pre>{CODE.input}</pre></section>

    <section><h2>PoolChip</h2><p>Flat little pills, and soft ones you can remove!</p>
        <div class="row"><PoolChip>Heated</PoolChip><PoolChip tone="orange">Lifeguard on duty</PoolChip>
            {#each tags as t (t)}<PoolChip tone="soft" removeLabel={'Remove ' + t} onremove={() => (tags = tags.filter((x) => x !== t))}>{t}</PoolChip>{/each}
            {#if tags.length < 4}<PoolButton size="small" tone="ghost" onclick={() => (tags = ['Heated', 'Kids pool', 'Diving board', 'Sun loungers'])}>Bring them back</PoolButton>{/if}</div>
