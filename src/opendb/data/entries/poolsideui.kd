~~~ file: PoolTabs.svelte
<!--
  PoolTabs.svelte: tabs as swimming lanes, split by orange-and-white lane ropes; the open lane fills with water!

  <PoolTabs tabs={['Lap swim', 'Lessons', 'Free swim']} bind:active>
    {#snippet panel(i)}
      {#if i === 0}Mornings 6 to 9!{:else if i === 1}Saturdays!{:else}Every afternoon!{/if}
    {/snippet}
  </PoolTabs>

  Props: tabs (a list of labels), active (bindable index), panel (a snippet that gets the open index), onchange(i), class.
  Arrow keys, Home and End move between lanes, like any tab bar.
-->
<script>
    let { tabs = [], active = $bindable(0), panel = undefined, onchange = undefined, class: className = '' } = $props();
    let bar = $state();
    const uid = 'plt' + Math.random().toString(36).slice(2, 8);
    function pick(i, focus) {
        if (i < 0 || i >= tabs.length) return;
        active = i;
        if (typeof onchange === 'function') onchange(i);
        if (focus && bar) bar.querySelectorAll('[role="tab"]')[i]?.focus();
    }
    function keys(e) {
        const n = tabs.length, map = { ArrowRight: active + 1, ArrowDown: active + 1, ArrowLeft: active - 1 + n, ArrowUp: active - 1 + n, Home: 0, End: n - 1 };
        if (!(e.key in map)) return;
        e.preventDefault();
        pick(map[e.key] % n, true);
    }
</script>

<div class="pool-tabs {className}">
    <div class="pool-lanes" role="tablist" tabindex="-1" bind:this={bar} onkeydown={keys}>
        {#each tabs as t, i (i)}
            <button type="button" role="tab" id={uid + '-t' + i} aria-controls={uid + '-p' + i} aria-selected={active === i} tabindex={active === i ? 0 : -1} onclick={() => pick(i)}>{t}</button>
        {/each}
    </div>
    <div class="pool-panel" role="tabpanel" id={uid + '-p' + active} aria-labelledby={uid + '-t' + active}>
        {#if panel}{@render panel(active)}{/if}
    </div>
</div>

<style>
    .pool-tabs { font-family: var(--pool-font, system-ui, sans-serif); color: var(--pool-ink, #0c4a6e); border-radius: var(--pool-radius, 16px); overflow: hidden; border: 1px solid var(--pool-line, rgba(14, 165, 233, 0.4)); background: var(--pool-tile, #f0fdff); box-shadow: 0 6px 18px var(--pool-shadow, rgba(8, 145, 178, 0.22)); }
    .pool-lanes { display: flex; overflow-x: auto; background: var(--pool-water-soft, #d6f4fc); }
    .pool-lanes button { position: relative; flex: 1; min-width: max-content; padding: 10px 18px; border: 0; background: none; cursor: pointer; font: 700 14px var(--pool-font, system-ui, sans-serif); color: var(--pool-deep, #075985); }
    /* the lane rope between lanes: orange and white floats */
    .pool-lanes button + button::before { content: ''; position: absolute; left: -2px; top: 6px; bottom: 6px; width: 4px; border-radius: 2px;
        background: repeating-linear-gradient(180deg, var(--pool-orange, #f97316) 0 5px, #fff 5px 10px); box-shadow: 0 0 0 1px rgba(194, 65, 12, 0.25); }
    .pool-lanes button[aria-selected='true'] { color: var(--pool-deep, #075985); background: var(--pool-tile, #f0fdff); box-shadow: inset 0 3px 0 var(--pool-water-3, #00b2e3); }
    .pool-lanes button:hover:not([aria-selected='true']) { background: rgba(255, 255, 255, 0.6); }
    .pool-lanes button:focus-visible { outline: 3px solid var(--pool-orange, #f97316); outline-offset: -3px; }
    .pool-panel { padding: 14px 18px; line-height: 1.5; }
</style>
