~~~ file: PoolToaster.svelte
<!--
  PoolToaster.svelte: little messages that float up like bubbles from the corner of the screen!

  Put one PoolToaster on the page, then call toast() from anywhere:
  <script>
    import PoolToaster, { toast } from './PoolToaster.svelte';
  </script>
  <PoolToaster />
  <PoolButton onclick={() => toast('Saved!')}>Save</PoolButton>
  toast('The pool is closing in 10 minutes!', { tone: 'orange', time: 6000 });

  toast(message, { tone: 'water' | 'orange', time: milliseconds (default 3500; 0 stays until closed) }) returns an id;
  dismiss(id) closes one early. Props: place ('bottom-right' default, 'bottom-left', 'top-right', 'top-left', 'bottom').
  Messages are announced to screen readers (role="status").
-->
<script module>
    let list = $state([]);
    let n = 0;
    export function toast(message, opts = {}) {
        const id = ++n;
        list.push({ id, message: String(message), tone: opts.tone === 'orange' ? 'orange' : 'water' });
        const time = opts.time ?? 3500;
        if (time > 0) setTimeout(() => dismiss(id), time);
        return id;
    }
    export function dismiss(id) {
        const i = list.findIndex((t) => t.id === id);
        if (i >= 0) list.splice(i, 1);
    }
</script>

<script>
    let { place = 'bottom-right' } = $props();
</script>

<div class="pool-toasts pool-{place}" role="status" aria-live="polite">
    {#each list as t (t.id)}
        <div class="pool-toast pool-t-{t.tone}">
            <span class="pool-bubble" aria-hidden="true"></span>
            <span class="pool-toast-msg">{t.message}</span>
            <button type="button" aria-label="Close message" onclick={() => dismiss(t.id)}><svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true"><path d="M2.5 2.5l7 7M9.5 2.5l-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg></button>
        </div>
    {/each}
</div>

<style>
    .pool-toasts { position: fixed; z-index: 2147483000; display: flex; flex-direction: column; gap: 8px; max-width: min(360px, calc(100vw - 24px)); pointer-events: none; font-family: var(--pool-font, system-ui, sans-serif); }
    .pool-bottom-right { right: 16px; bottom: 16px; }
    .pool-bottom-left { left: 16px; bottom: 16px; }
    .pool-top-right { right: 16px; top: 16px; flex-direction: column-reverse; }
    .pool-top-left { left: 16px; top: 16px; flex-direction: column-reverse; }
    .pool-bottom { left: 50%; bottom: 16px; transform: translateX(-50%); }
    .pool-toast { pointer-events: auto; display: flex; align-items: center; gap: 10px; padding: 10px 10px 10px 12px; border-radius: 14px; font: 600 14px var(--pool-font, system-ui, sans-serif); color: var(--pool-ink, #0c4a6e);
        background: linear-gradient(180deg, #ffffff, #ecfeff); border: 1px solid var(--pool-line, rgba(14, 165, 233, 0.4)); box-shadow: 0 10px 24px rgba(7, 89, 133, 0.22); animation: pool-float 0.35s cubic-bezier(.3, 1.4, .5, 1); }
    .pool-t-orange { box-shadow: inset 4px 0 0 var(--pool-orange, #f97316), 0 10px 24px rgba(7, 89, 133, 0.22); }
    .pool-bubble { flex: none; width: 18px; height: 18px; border-radius: 50%; border: 1px solid rgba(2, 132, 199, 0.5);
        background: radial-gradient(circle at 32% 28%, #fff 0 20%, transparent 24%), radial-gradient(circle, rgba(103, 232, 249, 0.2), rgba(2, 132, 199, 0.55)); }
    .pool-t-orange .pool-bubble { border-color: var(--pool-orange-deep, #c2410c); background: radial-gradient(circle at 32% 28%, #fff 0 20%, transparent 24%), radial-gradient(circle, #fdba74, var(--pool-orange, #f97316)); }
    .pool-toast-msg { flex: 1; }
    .pool-toast button { display: inline-flex; padding: 5px; border: 0; border-radius: 50%; background: none; color: var(--pool-deep, #075985); cursor: pointer; }
    .pool-toast button:hover { background: rgba(2, 132, 199, 0.12); }
    .pool-toast button:focus-visible { outline: 2px solid var(--pool-orange, #f97316); }
    @keyframes pool-float { from { transform: translateY(14px) scale(0.96); opacity: 0; } }
    @media (prefers-reduced-motion: reduce) { .pool-toast { animation: none; } }
</style>
