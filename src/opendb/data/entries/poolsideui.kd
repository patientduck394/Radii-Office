~~~ file: PoolAlert.svelte
<!--
  PoolAlert.svelte: a message banner, calm water for news and an orange edge for warnings!

  <PoolAlert title="Pool closes early">Today at 6, for cleaning!</PoolAlert>
  <PoolAlert tone="warning" title="No running!" dismissible bind:open>The deck is slippery.</PoolAlert>

  Props: tone ('info' default, 'success', 'warning', 'danger'), title, dismissible (shows a × that sets open to false),
         open (bindable, default true), children, actions (a snippet for buttons), class.
  Warnings and dangers are announced right away (role="alert"); the others politely (role="status").
-->
<script>
    let { tone = 'info', title = '', dismissible = false, open = $bindable(true), children = undefined, actions = undefined, class: className = '' } = $props();
    const ICONS = {
        info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v6M12 7.5v.5"/>',
        success: '<circle cx="12" cy="12" r="9"/><path d="M8 12.5l2.8 2.8L16.5 9"/>',
        warning: '<path d="M12 3.5l9.5 16.5h-19z"/><path d="M12 10v4.5M12 17.2v.3"/>',
        danger: '<circle cx="12" cy="12" r="9"/><path d="M9 9l6 6M15 9l-6 6"/>'
    };
    const loud = $derived(tone === 'warning' || tone === 'danger');
</script>

{#if open}
    <div class="pool-alert pool-{tone} {className}" role={loud ? 'alert' : 'status'}>
        <svg class="pool-alert-icon" viewBox="0 0 24 24" aria-hidden="true">{@html ICONS[tone] || ICONS.info}</svg>
        <div class="pool-alert-text">
            {#if title}<b>{title}</b>{/if}
            {#if children}<div>{@render children()}</div>{/if}
            {#if actions}<div class="pool-alert-actions">{@render actions()}</div>{/if}
        </div>
        {#if dismissible}<button type="button" aria-label="Dismiss" onclick={() => (open = false)}><svg viewBox="0 0 12 12" width="11" height="11" aria-hidden="true"><path d="M2.5 2.5l7 7M9.5 2.5l-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg></button>{/if}
    </div>
{/if}

<style>
    .pool-alert { display: flex; gap: 12px; align-items: flex-start; padding: 12px 14px; border-radius: 14px; font: 14px/1.45 var(--pool-font, system-ui, sans-serif); color: var(--pool-ink, #0c4a6e);
        border: 1px solid var(--pool-line, rgba(14, 165, 233, 0.4)); background: linear-gradient(180deg, #ffffff, #ecfeff); box-shadow: 0 4px 12px rgba(8, 145, 178, 0.12); }
    .pool-success { background: linear-gradient(180deg, #ffffff, #e6fff7); border-color: rgba(16, 185, 129, 0.45); }
    /* warnings keep the water background: the orange is the edge and the icon, not a wash of color */
    .pool-warning { box-shadow: inset 5px 0 0 var(--pool-orange, #f97316), 0 4px 12px rgba(8, 145, 178, 0.12); padding-left: 18px; }
    .pool-danger { box-shadow: inset 5px 0 0 #dc2626, 0 4px 12px rgba(8, 145, 178, 0.12); padding-left: 18px; background: linear-gradient(180deg, #ffffff, #fff1f2); border-color: rgba(220, 38, 38, 0.35); }
    .pool-alert-icon { flex: none; width: 22px; height: 22px; fill: none; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; stroke: var(--pool-water-3, #00b2e3); }
    .pool-success .pool-alert-icon { stroke: #059669; }
    .pool-warning .pool-alert-icon { stroke: var(--pool-orange, #f97316); }
    .pool-danger .pool-alert-icon { stroke: #dc2626; }
    .pool-alert-text { flex: 1; min-width: 0; }
    b { display: block; color: var(--pool-deep, #075985); }
    .pool-alert-actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
    button { flex: none; display: inline-flex; padding: 6px; border: 0; border-radius: 50%; background: none; color: var(--pool-deep, #075985); cursor: pointer; }
    button:hover { background: rgba(2, 132, 199, 0.12); }
    button:focus-visible { outline: 2px solid var(--pool-orange, #f97316); }
</style>
~~~

~~~ file: PoolAvatar.svelte
<!--
  PoolAvatar.svelte: a round porthole with a picture or initials, and a little status float!

  <PoolAvatar name="Marina Costa" />                     (shows MC on water)
  <PoolAvatar name="Kai" src="/kai.jpg" status="online" size="56px" />

  Props: name (used for the initials and the description), src (a picture), size (default '40px'),
         status ('online' (orange float, in the water), 'away', 'offline', or none), ring (the white and orange ring, default true), class.
-->
<script>
    let { name = '', src = undefined, size = '40px', status = undefined, ring = true, class: className = '' } = $props();
    let broken = $state(false);
    const initials = $derived(String(name).trim().split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0].toUpperCase()).join('') || '?');
    const desc = $derived((name || 'Someone') + (status ? ', ' + status : ''));
</script>

<span class="pool-avatar {className}" class:ring style:--pa={size} role="img" aria-label={desc}>
    {#if src && !broken}<img {src} alt="" onerror={() => (broken = true)} />{:else}<span class="pool-initials" aria-hidden="true">{initials}</span>{/if}
    {#if status}<span class="pool-status pool-{status}" aria-hidden="true"></span>{/if}
</span>

<style>
    .pool-avatar { position: relative; display: inline-flex; flex: none; width: var(--pa); height: var(--pa); border-radius: 50%; vertical-align: middle; font-family: var(--pool-font, system-ui, sans-serif); }
    .ring { box-shadow: 0 0 0 2px #fff, 0 0 0 4px var(--pool-orange, #f97316), 0 3px 8px rgba(7, 89, 133, 0.3); }
    img, .pool-initials { width: 100%; height: 100%; border-radius: 50%; overflow: hidden; }
    img { object-fit: cover; }
    .pool-initials { display: flex; align-items: center; justify-content: center; color: #fff; font-weight: 800; font-size: calc(var(--pa) * 0.38); text-shadow: 0 1px 2px rgba(7, 89, 133, 0.5);
        background: radial-gradient(circle at 35% 25%, rgba(255, 255, 255, 0.55), transparent 45%), linear-gradient(180deg, var(--pool-water-1, #67e8f9), var(--pool-water-3, #00b2e3)); }
    .pool-status { position: absolute; right: -1px; bottom: -1px; width: calc(var(--pa) * 0.3); height: calc(var(--pa) * 0.3); min-width: 10px; min-height: 10px; border-radius: 50%; border: 2px solid #fff; }
    .pool-online { background: radial-gradient(circle at 35% 30%, #fff 0 15%, transparent 20%), var(--pool-orange, #f97316); }
    .pool-away { background: #fde68a; }
    .pool-offline { background: #94a3b8; }
</style>
