~~~ file: PoolAccordion.svelte
<!--
  PoolAccordion.svelte: questions that open one at a time (or several), each bar with an orange edge and arrow!

  <PoolAccordion items={[
    { title: 'Do I need a swim cap?', text: 'Only in the lap lanes!' },
    { title: 'Is there a deep end?', text: 'Yes, 3.8 metres, with a diving board.' }
  ]} />
  <PoolAccordion items={faq} multiple bind:open />

  Props: items ([{ title, text }]), open (bindable list of open indexes), multiple (several may be open at once), item (a snippet
         that gets (entry, index) to draw the inside yourself instead of text), class.
-->
<script>
    let { items = [], open = $bindable([]), multiple = false, item = undefined, class: className = '' } = $props();
    const uid = 'pla' + Math.random().toString(36).slice(2, 8);
    function flip(i) {
        const isOpen = open.includes(i);
        open = isOpen ? open.filter((x) => x !== i) : multiple ? [...open, i] : [i];
    }
</script>

<div class="pool-acc {className}">
    {#each items as it, i (i)}
        {@const isOpen = open.includes(i)}
        <section class="pool-acc-item" class:on={isOpen}>
            <h3><button type="button" id={uid + '-b' + i} aria-expanded={isOpen} aria-controls={uid + '-p' + i} onclick={() => flip(i)}>
                <svg class="pool-acc-chev" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg>
                <span>{it.title}</span>
            </button></h3>
            <div class="pool-acc-body" id={uid + '-p' + i} role="region" aria-labelledby={uid + '-b' + i} hidden={!isOpen}>
                {#if item}{@render item(it, i)}{:else}{it.text}{/if}
            </div>
        </section>
    {/each}
</div>

<style>
    .pool-acc { display: flex; flex-direction: column; gap: 8px; font-family: var(--pool-font, system-ui, sans-serif); color: var(--pool-ink, #0c4a6e); }
    .pool-acc-item { border-radius: 14px; overflow: hidden; border: 1px solid var(--pool-line, rgba(14, 165, 233, 0.4)); background: var(--pool-tile, #f0fdff); box-shadow: 0 3px 10px rgba(8, 145, 178, 0.12); }
    h3 { margin: 0; }
    h3 button { display: flex; align-items: center; gap: 10px; width: 100%; padding: 11px 14px; border: 0; cursor: pointer; text-align: left; font: 700 15px var(--pool-font, system-ui, sans-serif); color: var(--pool-deep, #075985);
        background: linear-gradient(180deg, #ffffff 0%, #ecfeff 50%, #a5f3fc 100%); box-shadow: inset 4px 0 0 var(--pool-orange, #f97316), inset 0 1px 0 #fff; }
    .on h3 button { color: #fff; text-shadow: 0 1px 2px rgba(7, 89, 133, 0.5); background: linear-gradient(180deg, var(--pool-water-1, #67e8f9), var(--pool-water-3, #00b2e3)); }
    h3 button:focus-visible { outline: 3px solid var(--pool-orange, #f97316); outline-offset: -3px; }
    .pool-acc-chev { flex: none; color: var(--pool-orange-deep, #c2410c); transition: transform 0.2s; }
    .on .pool-acc-chev { transform: rotate(90deg); color: #fff; }
    .pool-acc-body { padding: 12px 16px 14px; line-height: 1.5; border-top: 1px solid var(--pool-line, rgba(14, 165, 233, 0.4)); }
    @media (prefers-reduced-motion: reduce) { .pool-acc-chev { transition: none; } }
</style>
