~~~ file: PoolButton.svelte
<!--
  PoolButton.svelte: a flat water button that sends out a ripple where you press it!

  <PoolButton onclick={save}>Save</PoolButton>
  <PoolButton tone="orange">Dive in!</PoolButton>
  <PoolButton tone="ghost" size="small" href="/rules">Pool rules</PoolButton>

  Props: tone ('water' default, 'orange' like a life ring, 'ghost' see-through), size ('small' | 'medium' | 'large'),
         href (makes it a link), disabled, type ('button' default), onclick, class, style, and anything else goes on the element.
-->
<script>
    let { tone = 'water', size = 'medium', href = undefined, disabled = false, type = 'button', onclick = undefined, children = undefined, class: className = '', ...rest } = $props();
    let ripples = $state([]);
    let n = 0;
    function press(e) {
        if (disabled) return;
        const r = e.currentTarget.getBoundingClientRect();
        const id = ++n;
        ripples = [...ripples, { id, x: e.clientX - r.left, y: e.clientY - r.top }];
        setTimeout(() => { ripples = ripples.filter((p) => p.id !== id); }, 650);
    }
</script>

<svelte:element this={href && !disabled ? 'a' : 'button'} href={href && !disabled ? href : undefined} type={href ? undefined : type} disabled={href ? undefined : disabled}
    aria-disabled={href && disabled ? 'true' : undefined}
    class="pool-btn pool-{tone} pool-{size} {className}" onpointerdown={press} {onclick} {...rest}>
    <span class="pool-btn-label">{#if children}{@render children()}{/if}</span>
    {#each ripples as p (p.id)}<span class="pool-ripple" style:left={p.x + 'px'} style:top={p.y + 'px'}></span>{/each}
</svelte:element>

<style>
    .pool-btn { position: relative; display: inline-flex; align-items: center; justify-content: center; gap: 6px; overflow: hidden; isolation: isolate;
        font: 700 15px var(--pool-font, system-ui, sans-serif); text-decoration: none; cursor: pointer; border-radius: 999px; border: 2px solid; transition: transform 0.12s, background 0.12s; }
    .pool-small { padding: 5px 14px; font-size: 13px; }
    .pool-medium { padding: 9px 22px; }
    .pool-large { padding: 13px 30px; font-size: 18px; }
    /* flat buttons: the main colour is the border, a lighter shade of it is the fill */
    .pool-water { color: var(--pool-deep, #075985); border-color: var(--pool-water-3, #00b2e3); background: var(--pool-water-soft, #d6f4fc); }
    .pool-orange { color: var(--pool-orange-deep, #c2410c); border-color: var(--pool-orange, #f97316); background: var(--pool-orange-soft, #ffe9d6); }
    .pool-ghost { color: var(--pool-deep, #075985); border-color: var(--pool-line, rgba(14, 165, 233, 0.4)); background: #fff; }
    .pool-btn:hover:not([disabled]):not([aria-disabled='true']) { background: color-mix(in srgb, var(--pool-water-3, #00b2e3) 26%, #fff); }
    .pool-orange:hover:not([disabled]):not([aria-disabled='true']) { background: color-mix(in srgb, var(--pool-orange, #f97316) 26%, #fff); }
    .pool-ghost:hover:not([disabled]):not([aria-disabled='true']) { background: var(--pool-water-soft, #d6f4fc); }
    .pool-btn:active:not([disabled]) { transform: translateY(1px); }
    .pool-btn:focus-visible { outline: 3px solid var(--pool-orange, #f97316); outline-offset: 2px; }
    .pool-ghost:focus-visible { outline-color: var(--pool-water-3, #00b2e3); }
    .pool-btn[disabled], .pool-btn[aria-disabled='true'] { opacity: 0.5; cursor: not-allowed; }
    .pool-btn-label { position: relative; z-index: 1; }
    .pool-ripple { position: absolute; z-index: 0; width: 12px; height: 12px; margin: -6px 0 0 -6px; border-radius: 50%; border: 2px solid var(--pool-water-2, #22d3ee); pointer-events: none; animation: pool-ripple 0.65s ease-out forwards; }
    .pool-orange .pool-ripple { border-color: var(--pool-orange, #f97316); }
    @keyframes pool-ripple { to { transform: scale(14); opacity: 0; } }
    @media (prefers-reduced-motion: reduce) { .pool-ripple { display: none; } .pool-btn { transition: none; } }
</style>
~~~

~~~ file: PoolCard.svelte
<!--
  PoolCard.svelte: a white tile card with a rippling water header and an orange stripe under it!

  <PoolCard title="Pool party">
    Saturday at noon, bring a towel!
    {#snippet footer()}<PoolButton size="small">I'm coming!</PoolButton>{/snippet}
  </PoolCard>

  Props: title, subtitle, icon (an SVG string, shown in a life ring), href (the whole card becomes a link),
         flat (no header: just the tile body with the orange stripe on top), children, footer (snippet), class, style.
-->
<script>
    let { title = '', subtitle = '', icon = '', href = undefined, flat = false, children = undefined, footer = undefined, class: className = '', style = undefined } = $props();
</script>

<svelte:element this={href ? 'a' : 'article'} {href} class="pool-card {className}" class:pool-flat={flat} {style}>
    {#if !flat && (title || icon)}
        <header class="pool-card-head">
            {#if icon}<span class="pool-card-ring" aria-hidden="true">{@html icon}</span>{/if}
            <span><b class="pool-card-title">{title}</b>{#if subtitle}<small>{subtitle}</small>{/if}</span>
        </header>
    {/if}
    <div class="pool-card-body">{#if children}{@render children()}{/if}</div>
    {#if footer}<footer class="pool-card-foot">{@render footer()}</footer>{/if}
</svelte:element>

<style>
    .pool-card { display: flex; flex-direction: column; border-radius: var(--pool-radius, 16px); overflow: hidden; color: var(--pool-ink, #0c4a6e); text-decoration: none; font-family: var(--pool-font, system-ui, sans-serif);
        background: var(--pool-tile, #f0fdff); border: 1px solid var(--pool-line, rgba(14, 165, 233, 0.4)); box-shadow: 0 8px 22px var(--pool-shadow, rgba(8, 145, 178, 0.22)), inset 0 1px 0 #fff; transition: transform 0.15s, box-shadow 0.15s; }
    a.pool-card:hover { transform: translateY(-2px); box-shadow: 0 12px 28px var(--pool-shadow, rgba(8, 145, 178, 0.22)); }
    a.pool-card:focus-visible { outline: 3px solid var(--pool-orange, #f97316); outline-offset: 2px; }
    .pool-card-head { display: flex; align-items: center; gap: 10px; padding: 12px 16px; color: #fff; text-shadow: 0 1px 2px rgba(7, 89, 133, 0.5);
        background: radial-gradient(120% 60% at 20% 0%, rgba(255, 255, 255, 0.5), transparent 60%), repeating-radial-gradient(circle at 85% 150%, rgba(255, 255, 255, 0.14) 0 6px, transparent 6px 14px), linear-gradient(180deg, var(--pool-water-1, #67e8f9), var(--pool-water-3, #00b2e3));
        box-shadow: inset 0 -4px 0 var(--pool-orange, #f97316); }
    .pool-card-head > span:last-child { display: flex; flex-direction: column; min-width: 0; }
    .pool-card-title { font-size: 17px; font-weight: 800; }
    .pool-card-head small { font-size: 12.5px; opacity: 0.92; }
    /* the icon sits in a little life ring: white with orange bands */
    .pool-card-ring { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 50%; color: var(--pool-deep, #075985);
        background: radial-gradient(circle, #fff 0 55%, transparent 56%), conic-gradient(var(--pool-orange, #f97316) 0 45deg, #fff 45deg 90deg, var(--pool-orange, #f97316) 90deg 135deg, #fff 135deg 180deg, var(--pool-orange, #f97316) 180deg 225deg, #fff 225deg 270deg, var(--pool-orange, #f97316) 270deg 315deg, #fff 315deg);
        box-shadow: 0 2px 6px rgba(7, 89, 133, 0.35); text-shadow: none; }
    .pool-card-ring :global(svg) { width: 16px; height: 16px; }
    .pool-card-body { padding: 14px 16px; flex: 1; line-height: 1.5; background-image: linear-gradient(var(--pool-tile-line, #cff4fc) 1px, transparent 1px), linear-gradient(90deg, var(--pool-tile-line, #cff4fc) 1px, transparent 1px); background-size: 22px 22px; background-position: -1px -1px; }
    .pool-flat { border-top: 4px solid var(--pool-orange, #f97316); }
    .pool-card-foot { display: flex; gap: 8px; justify-content: flex-end; padding: 10px 16px; border-top: 1px solid var(--pool-line, rgba(14, 165, 233, 0.4)); background: rgba(255, 255, 255, 0.8); }
    @media (prefers-reduced-motion: reduce) { .pool-card { transition: none; } }
</style>
