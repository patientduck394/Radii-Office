~~~ file: PoolCheckbox.svelte
<!--
  PoolCheckbox.svelte: a checkbox like a little water tile that fills up, with an orange tick!

  <PoolCheckbox bind:checked={agree}>I read the pool rules</PoolCheckbox>
  <PoolCheckbox bind:checked label="Towel service" indeterminate={some} />

  Props: checked (bindable), label (or words between the tags), indeterminate (a dash, for "some of them"), disabled,
         name, value, onchange(checked), class. It is a real checkbox underneath, so forms and keyboards just work.
-->
<script>
    let { checked = $bindable(false), label = '', indeterminate = false, disabled = false, name = undefined, value = undefined, onchange = undefined, children = undefined, class: className = '' } = $props();
    let box = $state();
    $effect(() => { if (box) box.indeterminate = !!indeterminate && !checked; });
</script>

<label class="pool-check {className}" class:off-limits={disabled}>
    <input type="checkbox" bind:this={box} bind:checked {disabled} {name} {value} onchange={() => { if (typeof onchange === 'function') onchange(checked); }} />
    <span class="pool-box" aria-hidden="true">
        <svg viewBox="0 0 16 16"><path class="pool-tick" d="M3.5 8.5l3 3 6-7" /><path class="pool-dash" d="M4 8h8" /></svg>
    </span>
    {#if label || children}<span class="pool-check-label">{#if children}{@render children()}{:else}{label}{/if}</span>{/if}
</label>

<style>
    .pool-check { display: inline-flex; align-items: center; gap: 9px; font: 600 14px var(--pool-font, system-ui, sans-serif); color: var(--pool-ink, #0c4a6e); cursor: pointer; position: relative; }
    .off-limits { opacity: 0.5; cursor: not-allowed; }
    input { position: absolute; opacity: 0; width: 22px; height: 22px; margin: 0; cursor: inherit; }
    .pool-box { flex: none; display: inline-flex; width: 22px; height: 22px; border-radius: 7px; border: 2px solid var(--pool-water-3, #00b2e3); box-sizing: border-box;
        background: #fff; transition: background 0.15s; }
    input:checked + .pool-box, input:indeterminate + .pool-box { background: var(--pool-water-soft, #d6f4fc); }
    svg { width: 100%; height: 100%; fill: none; stroke-linecap: round; stroke-linejoin: round; }
    .pool-tick, .pool-dash { stroke: var(--pool-deep, #075985); stroke-width: 2.4; opacity: 0; }
    /* the tick has an orange shadow line under it: the accent, never mixed into the water */
    input:checked + .pool-box .pool-tick { opacity: 1; filter: drop-shadow(0 1.2px 0 var(--pool-orange, #f97316)); }
    input:indeterminate + .pool-box .pool-dash { opacity: 1; filter: drop-shadow(0 1.2px 0 var(--pool-orange, #f97316)); }
    input:focus-visible + .pool-box { outline: 3px solid var(--pool-orange, #f97316); outline-offset: 2px; }
    @media (prefers-reduced-motion: reduce) { .pool-box { transition: none; } }
</style>
~~~

~~~ file: PoolChip.svelte
<!--
  PoolChip.svelte: a flat little pill (a tag, a count, a status), in water or orange, that can be removed!

  <PoolChip>Heated</PoolChip>
  <PoolChip tone="orange">Lifeguard on duty</PoolChip>
  <PoolChip tone="soft" onremove={() => drop(tag)}>{tag}</PoolChip>

  Props: tone ('water' default, 'orange', 'soft' pale water), onremove (shows a × button that calls it), removeLabel
         (its name for screen readers, default 'Remove'), class.
-->
<script>
    let { tone = 'water', onremove = undefined, removeLabel = 'Remove', children = undefined, class: className = '' } = $props();
</script>

<span class="pool-chip pool-{tone} {className}">
    <span>{#if children}{@render children()}{/if}</span>
    {#if typeof onremove === 'function'}
        <button type="button" class="pool-chip-x" aria-label={removeLabel} onclick={onremove}><svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true"><path d="M2.5 2.5l7 7M9.5 2.5l-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg></button>
    {/if}
</span>

<style>
    .pool-chip { display: inline-flex; align-items: center; gap: 4px; padding: 3px 11px; border-radius: 999px; font: 700 12.5px var(--pool-font, system-ui, sans-serif); line-height: 1.4; vertical-align: middle; border: 2px solid; white-space: nowrap; }
    .pool-water { color: var(--pool-deep, #075985); border-color: var(--pool-water-3, #00b2e3); background: var(--pool-water-soft, #d6f4fc); }
    .pool-orange { color: var(--pool-orange-deep, #c2410c); border-color: var(--pool-orange, #f97316); background: var(--pool-orange-soft, #ffe9d6); }
    .pool-soft { color: var(--pool-deep, #075985); border-color: var(--pool-line, rgba(14, 165, 233, 0.4)); background: #fff; box-shadow: inset 3px 0 0 var(--pool-orange, #f97316); padding-left: 13px; }
    .pool-chip-x { display: inline-flex; align-items: center; justify-content: center; width: 16px; height: 16px; margin-right: -5px; padding: 0; border: 0; border-radius: 50%; background: rgba(0, 178, 227, 0.16); color: inherit; cursor: pointer; }
    .pool-soft .pool-chip-x { background: rgba(2, 132, 199, 0.12); }
    .pool-chip-x:hover { background: rgba(0, 178, 227, 0.3); }
    .pool-chip-x:focus-visible { outline: 2px solid var(--pool-orange, #f97316); outline-offset: 1px; }
    .pool-orange .pool-chip-x { background: rgba(249, 115, 22, 0.18); }
    .pool-orange .pool-chip-x:hover { background: rgba(249, 115, 22, 0.32); }
</style>
