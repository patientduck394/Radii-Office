~~~ file: PoolStat.svelte
<!--
  PoolStat.svelte: a number tile for dashboards, with how it changed and a small wave-line chart!

  <PoolStat label="Swimmers today" value={312} change={+8.4} />
  <PoolStat label="Water temperature" value="27.5" unit="°C" change={-0.5} trend={[27.9, 28.1, 27.8, 27.6, 27.5]} />

  Props: label, value, unit, change (a percent or amount: up shows in water blue, down in orange), changeUnit (default '%'),
         trend (a list of numbers for the line), hint, class.
-->
<script>
    let { label = '', value = '', unit = '', change = undefined, changeUnit = '%', trend = undefined, hint = '', class: className = '' } = $props();
    const up = $derived(typeof change === 'number' && change >= 0);
    const path = $derived.by(() => {
        if (!Array.isArray(trend) || trend.length < 2) return '';
        const lo = Math.min(...trend), hi = Math.max(...trend), span = hi - lo || 1;
        return trend.map((v, i) => (i ? 'L' : 'M') + ((i / (trend.length - 1)) * 100).toFixed(1) + ' ' + (26 - ((v - lo) / span) * 22).toFixed(1)).join(' ');
    });
    const said = $derived(typeof change === 'number' ? (up ? 'up ' : 'down ') + Math.abs(change) + changeUnit : '');
</script>

<div class="pool-stat {className}">
    <div class="pool-stat-label">{label}</div>
    <div class="pool-stat-value">{value}{#if unit}<span class="pool-unit">{unit}</span>{/if}</div>
    {#if typeof change === 'number'}
        <div class="pool-change" class:down={!up} aria-label={said}>
            <svg viewBox="0 0 12 12" aria-hidden="true"><path d={up ? 'M6 2.5l3.5 4H2.5z' : 'M6 9.5l3.5-4H2.5z'} /></svg>{Math.abs(change)}{changeUnit}
        </div>
    {/if}
    {#if path}
        <svg class="pool-trend" viewBox="0 0 100 30" preserveAspectRatio="none" aria-hidden="true">
            <path class="pool-trend-fill" d={path + ' L100 30 L0 30 Z'} />
            <path class="pool-trend-line" d={path} />
        </svg>
    {/if}
    {#if hint}<div class="pool-stat-hint">{hint}</div>{/if}
</div>

<style>
    .pool-stat { position: relative; overflow: hidden; padding: 14px 16px 12px; border-radius: var(--pool-radius, 16px); font-family: var(--pool-font, system-ui, sans-serif); color: var(--pool-ink, #0c4a6e);
        background: linear-gradient(180deg, #ffffff, var(--pool-tile, #f0fdff)); border: 1px solid var(--pool-line, rgba(14, 165, 233, 0.4)); box-shadow: inset 0 4px 0 var(--pool-orange, #f97316), 0 6px 16px rgba(8, 145, 178, 0.14); }
    .pool-stat-label { font-size: 13px; font-weight: 700; color: #4b7a94; }
    .pool-stat-value { font-size: 32px; font-weight: 800; line-height: 1.15; color: var(--pool-deep, #075985); font-variant-numeric: tabular-nums; }
    .pool-unit { font-size: 18px; margin-left: 2px; color: var(--pool-water-3, #00b2e3); }
    .pool-change { display: inline-flex; align-items: center; gap: 3px; margin-top: 2px; padding: 1px 8px; border-radius: 999px; font: 700 12.5px var(--pool-font, system-ui, sans-serif); color: #fff; background: var(--pool-water-3, #00b2e3); }
    .pool-change.down { background: var(--pool-orange, #f97316); }
    .pool-change svg { width: 11px; height: 11px; fill: currentColor; }
    .pool-trend { display: block; width: 100%; height: 38px; margin-top: 8px; overflow: visible; }
    .pool-trend-fill { fill: rgba(34, 211, 238, 0.22); }
    .pool-trend-line { fill: none; stroke: var(--pool-water-3, #00b2e3); stroke-width: 2; vector-effect: non-scaling-stroke; stroke-linejoin: round; }
    .pool-stat-hint { margin-top: 6px; font-size: 12px; color: #4b7a94; }
</style>
~~~

~~~ file: PoolStepper.svelte
<!--
  PoolStepper.svelte: steps along a lane rope: done steps are full of water, the current one wears an orange ring!

  <PoolStepper steps={['Pick a lane', 'Choose a time', 'Pay', 'Swim!']} bind:current={step} />
  <PoolStepper steps={stages} current={2} clickable={false} />

  Props: steps (labels, or { label, hint }), current (bindable index), clickable (go back to a done step by clicking it, default true),
         onchange(index), class. The current step is marked aria-current="step".
-->
<script>
    let { steps = [], current = $bindable(0), clickable = true, onchange = undefined, class: className = '' } = $props();
    const list = $derived(steps.map((s) => (typeof s === 'object' && s ? s : { label: String(s) })));
    function go(i) { if (!clickable || i >= current) return; current = i; if (typeof onchange === 'function') onchange(i); }
</script>

<ol class="pool-steps {className}" style:--n={list.length}>
    {#each list as s, i (i)}
        <li class:done={i < current} class:now={i === current} aria-current={i === current ? 'step' : undefined}>
            {#if clickable && i < current}
                <button type="button" class="pool-step-dot" onclick={() => go(i)} aria-label={'Back to step ' + (i + 1) + ': ' + s.label}><svg viewBox="0 0 16 16" aria-hidden="true"><path d="M4 8.5l2.6 2.6L12 5.5" /></svg></button>
            {:else}
                <span class="pool-step-dot" aria-hidden="true">{#if i < current}<svg viewBox="0 0 16 16"><path d="M4 8.5l2.6 2.6L12 5.5" /></svg>{:else}{i + 1}{/if}</span>
            {/if}
            <span class="pool-step-text"><b>{s.label}</b>{#if s.hint}<small>{s.hint}</small>{/if}</span>
            <span class="pool-sr">{i < current ? '(done)' : i === current ? '(current step)' : ''}</span>
        </li>
    {/each}
</ol>

<style>
    .pool-steps { display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); list-style: none; margin: 0; padding: 0; font-family: var(--pool-font, system-ui, sans-serif); color: var(--pool-ink, #0c4a6e); }
    li { position: relative; display: flex; flex-direction: column; align-items: center; text-align: center; gap: 6px; padding: 0 4px; }
    /* the lane rope between steps: orange and white floats once you have passed it, plain water line before */
    li + li::before { content: ''; position: absolute; top: 15px; right: calc(50% + 20px); left: calc(-50% + 20px); height: 4px; border-radius: 2px; background: #bae6fd; }
    li.done + li::before, li.now::before { background: repeating-linear-gradient(90deg, var(--pool-orange, #f97316) 0 8px, #fff 8px 14px); box-shadow: 0 0 0 1px rgba(194, 65, 12, 0.25); }
    .pool-step-dot { display: inline-flex; align-items: center; justify-content: center; width: 34px; height: 34px; border-radius: 50%; font: 800 14px var(--pool-font, system-ui, sans-serif); padding: 0;
        color: var(--pool-deep, #075985); background: var(--pool-tile, #f0fdff); border: 2px solid #bae6fd; }
    .done .pool-step-dot { border-color: var(--pool-water-3, #00b2e3); background: var(--pool-water-soft, #d6f4fc); color: var(--pool-deep, #075985); }
    button.pool-step-dot { cursor: pointer; }
    button.pool-step-dot:hover { background: color-mix(in srgb, var(--pool-water-3, #00b2e3) 26%, #fff); }
    button.pool-step-dot:focus-visible { outline: 3px solid var(--pool-orange, #f97316); outline-offset: 2px; }
    .now .pool-step-dot { border-color: var(--pool-orange, #f97316); color: var(--pool-deep, #075985); background: var(--pool-water-soft, #d6f4fc); }
    .pool-step-dot svg { width: 16px; height: 16px; fill: none; stroke: var(--pool-deep, #075985); stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
    .pool-step-text { display: flex; flex-direction: column; font-size: 13px; }
    .now b { color: var(--pool-deep, #075985); }
    li:not(.done):not(.now) b { color: #5d8aa3; font-weight: 600; }
    small { color: #4b7a94; }
    .pool-sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
</style>
~~~

~~~ file: PoolTable.svelte
<!--
  PoolTable.svelte: a table with a water header row, tile-striped rows, and click-to-sort columns!

  <PoolTable caption="Race results" columns={[
    { key: 'name', label: 'Swimmer' },
    { key: 'lane', label: 'Lane', align: 'right' },
    { key: 'time', label: 'Time (s)', align: 'right', format: (v) => v.toFixed(2) }
  ]} rows={results} />

  Props: columns ([{ key, label, align, sortable (default true), format(value, row) }]), rows (objects), caption (a title, also for
         screen readers), sortBy / sortDir (bindable: a key and 'asc' | 'desc'), empty (text when there are no rows), class.
  Sorted columns say so with aria-sort. Wide tables scroll sideways inside their box.
-->
<script>
    let { columns = [], rows = [], caption = '', sortBy = $bindable(undefined), sortDir = $bindable('asc'), empty = 'Nothing here yet!', class: className = '' } = $props();
    const sorted = $derived.by(() => {
        if (!sortBy) return rows;
        const k = sortBy, d = sortDir === 'desc' ? -1 : 1;
        return [...rows].sort((a, b) => {
            const x = a[k], y = b[k];
            if (typeof x === 'number' && typeof y === 'number') return (x - y) * d;
            return String(x ?? '').localeCompare(String(y ?? ''), undefined, { numeric: true }) * d;
        });
    });
    function sort(c) {
        if (c.sortable === false) return;
        if (sortBy === c.key) sortDir = sortDir === 'asc' ? 'desc' : 'asc';
        else { sortBy = c.key; sortDir = 'asc'; }
    }
    const show = (c, r) => (typeof c.format === 'function' ? c.format(r[c.key], r) : r[c.key] ?? '');
</script>

<div class="pool-table-wrap {className}">
    <table class="pool-table">
        {#if caption}<caption>{caption}</caption>{/if}
        <thead>
            <tr>
                {#each columns as c (c.key)}
                    <th scope="col" style:text-align={c.align || 'left'} aria-sort={sortBy === c.key ? (sortDir === 'asc' ? 'ascending' : 'descending') : undefined}>
                        {#if c.sortable === false}{c.label}
                        {:else}<button type="button" onclick={() => sort(c)}>{c.label}<svg viewBox="0 0 12 12" aria-hidden="true" class:on={sortBy === c.key} class:desc={sortBy === c.key && sortDir === 'desc'}><path d="M3 7.5l3-3 3 3" /></svg></button>{/if}
                    </th>
                {/each}
            </tr>
        </thead>
        <tbody>
            {#each sorted as r, i (i)}
                <tr>{#each columns as c (c.key)}<td style:text-align={c.align || 'left'}>{show(c, r)}</td>{/each}</tr>
            {:else}
                <tr><td class="pool-empty" colspan={columns.length || 1}>{empty}</td></tr>
            {/each}
        </tbody>
    </table>
</div>

<style>
    .pool-table-wrap { overflow-x: auto; border-radius: var(--pool-radius, 16px); border: 1px solid var(--pool-line, rgba(14, 165, 233, 0.4)); box-shadow: 0 6px 18px rgba(8, 145, 178, 0.14); background: #fff; }
    .pool-table { width: 100%; border-collapse: collapse; font: 14px var(--pool-font, system-ui, sans-serif); color: var(--pool-ink, #0c4a6e); font-variant-numeric: tabular-nums; }
    caption { caption-side: top; text-align: left; padding: 10px 14px 8px; font-weight: 800; color: var(--pool-deep, #075985); background: var(--pool-tile, #f0fdff); }
    thead tr { background: linear-gradient(180deg, var(--pool-water-1, #67e8f9), var(--pool-water-3, #00b2e3)); box-shadow: inset 0 -3px 0 var(--pool-orange, #f97316); }
    th { padding: 10px 14px 12px; color: #fff; font-weight: 800; text-shadow: 0 1px 2px rgba(7, 89, 133, 0.5); white-space: nowrap; }
    th button { all: unset; display: inline-flex; align-items: center; gap: 5px; cursor: pointer; border-radius: 6px; }
    th button:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
    th svg { width: 12px; height: 12px; fill: none; stroke: rgba(255, 255, 255, 0.5); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.15s; }
    th svg.on { stroke: #fff; }
    th svg.desc { transform: rotate(180deg); }
    td { padding: 9px 14px; border-top: 1px solid var(--pool-tile-line, #cff4fc); }
    tbody tr:nth-child(even) td { background: var(--pool-tile, #f0fdff); }
    tbody tr:hover td { background: #cffafe; }
    .pool-empty { text-align: center !important; color: #5d8aa3; padding: 18px; }
</style>
