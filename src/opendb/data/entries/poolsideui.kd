~~~ file: PoolTiles.svelte
<!--
  PoolTiles.svelte: a backdrop for a section, like looking into a sunny pool: tiles, drifting light and a lane line!

  <PoolTiles>
    <h2>Summer hours</h2>
    <p>Open every day from 10 to 8!</p>
  </PoolTiles>

  Props: depth ('shallow' default, light water; 'deep' darker blue with white text), lane (the orange lane line, default true),
         padding (default '24px'), class, style. The light drifts slowly (and holds still for people who turn motion off).
-->
<script>
    let { depth = 'shallow', lane = true, padding = '24px', children = undefined, class: className = '', style = undefined } = $props();
</script>

<div class="pool-tiles pool-{depth} {className}" class:lane {style} style:--pt-pad={padding}>
    <div class="pool-light" aria-hidden="true"></div>
    <div class="pool-tiles-inner">{#if children}{@render children()}{/if}</div>
</div>

<style>
    .pool-tiles { position: relative; overflow: hidden; isolation: isolate; border-radius: var(--pool-radius, 16px); font-family: var(--pool-font, system-ui, sans-serif); border: 1px solid var(--pool-line, rgba(14, 165, 233, 0.4)); }
    .pool-shallow { color: var(--pool-ink, #0c4a6e); background-color: #a5f3fc; }
    .pool-deep { color: #fff; background-color: #0369a1; }
    /* the tiles: thin grout lines over the water color */
    .pool-tiles::before { content: ''; position: absolute; inset: 0; z-index: -2; background-image: linear-gradient(rgba(255, 255, 255, 0.45) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.45) 1px, transparent 1px); background-size: 26px 26px;
        background-color: transparent; }
    .pool-shallow::before { background-color: #cffafe; }
    .pool-deep::before { background-image: linear-gradient(rgba(255, 255, 255, 0.18) 1px, transparent 1px), linear-gradient(90deg, rgba(255, 255, 255, 0.18) 1px, transparent 1px); background-color: #0284c7; }
    /* the drifting light: soft caustic blobs */
    .pool-light { position: absolute; inset: -40%; z-index: -1; opacity: 0.55; pointer-events: none;
        background: radial-gradient(closest-side, rgba(255, 255, 255, 0.7), transparent) 10% 20% / 30% 22% no-repeat, radial-gradient(closest-side, rgba(255, 255, 255, 0.55), transparent) 60% 35% / 26% 18% no-repeat,
            radial-gradient(closest-side, rgba(255, 255, 255, 0.6), transparent) 35% 70% / 34% 20% no-repeat, radial-gradient(closest-side, rgba(255, 255, 255, 0.5), transparent) 85% 75% / 24% 20% no-repeat;
        animation: pool-drift 14s ease-in-out infinite alternate; }
    .pool-deep .pool-light { opacity: 0.25; }
    @keyframes pool-drift { to { transform: translate(6%, 4%) rotate(4deg); } }
    /* the lane line: a dark tile stripe with an orange rope float row along the bottom */
    .lane::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 6px; z-index: -1; background: repeating-linear-gradient(90deg, var(--pool-orange, #f97316) 0 14px, #fff 14px 28px); }
    .pool-tiles-inner { position: relative; padding: var(--pt-pad); padding-bottom: calc(var(--pt-pad) + 4px); }
    .pool-tiles-inner :global(h1), .pool-tiles-inner :global(h2), .pool-tiles-inner :global(h3) { margin-top: 0; text-shadow: 0 1px 0 rgba(255, 255, 255, 0.6); }
    .pool-deep .pool-tiles-inner :global(h1), .pool-deep .pool-tiles-inner :global(h2), .pool-deep .pool-tiles-inner :global(h3) { text-shadow: 0 1px 2px rgba(7, 89, 133, 0.6); }
    @media (prefers-reduced-motion: reduce) { .pool-light { animation: none; } }
</style>
