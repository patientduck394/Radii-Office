~~~ file: PoolPagination.svelte
<!--
  PoolPagination.svelte: page numbers as little floats, the current one full of water!

  <PoolPagination bind:page total={12} />
  <PoolPagination bind:page total={pages} around={1} label="Swim results pages" />

  Props: page (bindable, starting at 1), total (number of pages), around (how many numbers next to the current one, default 2),
         label (for screen readers, default 'Pages'), onchange(page), class. Long lists skip with "…".
-->
<script>
    let { page = $bindable(1), total = 1, around = 2, label = 'Pages', onchange = undefined, class: className = '' } = $props();
    const nums = $derived.by(() => {
        const out = [], t = Math.max(1, total);
        for (let n = 1; n <= t; n++) {
            if (n === 1 || n === t || Math.abs(n - page) <= around) out.push(n);
            else if (out[out.length - 1] !== '…') out.push('…');
        }
        return out;
    });
    function go(n) { n = Math.min(Math.max(1, total), Math.max(1, n)); if (n === page) return; page = n; if (typeof onchange === 'function') onchange(n); }
</script>

<nav class="pool-pages {className}" aria-label={label}>
    <button type="button" class="pool-page pool-arrow" aria-label="Previous page" disabled={page <= 1} onclick={() => go(page - 1)}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" /></svg></button>
    {#each nums as n, i (i)}
        {#if n === '…'}<span class="pool-gap" aria-hidden="true">…</span>
        {:else}<button type="button" class="pool-page" aria-current={n === page ? 'page' : undefined} aria-label={'Page ' + n} onclick={() => go(n)}>{n}</button>{/if}
    {/each}
    <button type="button" class="pool-page pool-arrow" aria-label="Next page" disabled={page >= total} onclick={() => go(page + 1)}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" /></svg></button>
</nav>

<style>
    .pool-pages { display: inline-flex; flex-wrap: wrap; align-items: center; gap: 5px; font-family: var(--pool-font, system-ui, sans-serif); }
    .pool-page { min-width: 34px; height: 34px; padding: 0 8px; border-radius: 999px; border: 2px solid var(--pool-line, rgba(14, 165, 233, 0.4)); cursor: pointer;
        background: #fff; color: var(--pool-deep, #075985); font: 700 14px var(--pool-font, system-ui, sans-serif); font-variant-numeric: tabular-nums; }
    .pool-page:hover:not(:disabled):not([aria-current]) { background: var(--pool-water-soft, #d6f4fc); }
    .pool-page[aria-current='page'] { color: var(--pool-deep, #075985); border-color: var(--pool-water-3, #00b2e3); background: var(--pool-water-soft, #d6f4fc); }
    .pool-page:disabled { opacity: 0.4; cursor: not-allowed; }
    .pool-page:focus-visible { outline: 3px solid var(--pool-orange, #f97316); outline-offset: 2px; }
    .pool-arrow svg { width: 16px; height: 16px; fill: none; stroke: var(--pool-orange-deep, #c2410c); stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; display: block; margin: auto; }
    .pool-gap { color: #5d8aa3; padding: 0 2px; }
</style>
~~~

~~~ file: PoolProgress.svelte
<!--
  PoolProgress.svelte: progress as the water level in a pool, with gentle waves on top!

  <PoolProgress value={uploaded} max={total} label="Filling the pool" />
  <PoolProgress value={0.4} max={1} shape="round" size="80px" />
  <PoolProgress label="Waiting…" />                      (no value: the water keeps rising and falling)

  Props: value (leave it out for "busy"), max (100), label, shape ('bar' default or 'round', a round porthole), size (the
         round one's width, default '96px'), showPercent (true), class. It is a role="progressbar" with the right aria values.
-->
<script>
    let { value = undefined, max = 100, label = '', shape = 'bar', size = '96px', showPercent = true, class: className = '' } = $props();
    const busy = $derived(value === undefined || value === null);
    const pct = $derived(busy ? 50 : Math.round(Math.min(100, Math.max(0, (value / (max || 1)) * 100))));
</script>

<div class="pool-progress pool-{shape} {className}" class:busy role="progressbar" aria-label={label || 'Progress'} aria-valuemin="0" aria-valuemax="100" aria-valuenow={busy ? undefined : pct} style:--pp-size={size}>
    {#if label && shape === 'bar'}<div class="pool-progress-top"><span>{label}</span>{#if showPercent && !busy}<b>{pct}%</b>{/if}</div>{/if}
    <div class="pool-tank">
        <div class="pool-water" style:height={pct + '%'} style:--w={pct + '%'}>
            <svg class="pool-wave" viewBox="0 0 120 10" preserveAspectRatio="none" aria-hidden="true"><path d="M0 5 Q15 0 30 5 T60 5 T90 5 T120 5 V10 H0 Z" /></svg>
        </div>
        {#if shape === 'round' && showPercent}<b class="pool-round-pct">{busy ? '…' : pct + '%'}</b>{/if}
    </div>
    {#if label && shape === 'round'}<div class="pool-round-label">{label}</div>{/if}
</div>

<style>
    .pool-progress { font: 600 13px var(--pool-font, system-ui, sans-serif); color: var(--pool-ink, #0c4a6e); }
    .pool-progress-top { display: flex; justify-content: space-between; margin-bottom: 4px; }
    .pool-progress-top b { color: var(--pool-deep, #075985); font-variant-numeric: tabular-nums; }
    .pool-tank { position: relative; overflow: hidden; background: var(--pool-tile, #f0fdff); border: 1px solid var(--pool-line, rgba(14, 165, 233, 0.4));
        background-image: linear-gradient(var(--pool-tile-line, #cff4fc) 1px, transparent 1px), linear-gradient(90deg, var(--pool-tile-line, #cff4fc) 1px, transparent 1px); background-size: 10px 10px; }
    .pool-bar .pool-tank { height: 18px; border-radius: 999px; box-shadow: inset 0 -3px 0 var(--pool-orange, #f97316); }
    /* in a bar the water fills sideways */
    .pool-bar .pool-water { position: absolute; left: 0; top: 0; bottom: 0; height: auto !important; width: var(--w); }
    .pool-water { position: absolute; left: 0; right: 0; bottom: 0; transition: height 0.4s, width 0.4s; background: linear-gradient(180deg, var(--pool-water-1, #67e8f9), var(--pool-water-3, #00b2e3)); }
    .pool-bar .pool-wave { display: none; }
    .pool-round .pool-tank { width: var(--pp-size); aspect-ratio: 1; border-radius: 50%; border: 4px solid #fff; box-shadow: 0 0 0 3px var(--pool-orange, #f97316), 0 6px 16px var(--pool-shadow, rgba(8, 145, 178, 0.22)), inset 0 4px 10px rgba(7, 89, 133, 0.2); }
    /* the wave path repeats every 60 of its 120 units (a crest and a trough), so one loop moves it exactly half its width:
       the end of a loop looks the same as the start, and it never jumps (it starts a whole tank to the left, so no gap shows) */
    .pool-wave { position: absolute; left: -100%; bottom: 100%; width: 200%; height: 10px; margin-bottom: -1px; fill: var(--pool-water-1, #67e8f9); animation: pool-wave 2.4s linear infinite; }
    @keyframes pool-wave { to { transform: translateX(50%); } }
    .pool-round-pct { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center; font-size: calc(var(--pp-size) / 4.5); color: var(--pool-deep, #075985); text-shadow: 0 0 6px #fff, 0 0 2px #fff; }
    .pool-round-label { text-align: center; margin-top: 8px; width: var(--pp-size); }
    .busy .pool-water { animation: pool-busy 2.2s ease-in-out infinite alternate; }
    .busy.pool-bar .pool-water { width: 40% !important; animation: pool-busy-bar 1.4s ease-in-out infinite alternate; }
    @keyframes pool-busy { from { height: 25%; } to { height: 75%; } }
    @keyframes pool-busy-bar { from { left: 0; } to { left: 60%; } }
    @media (prefers-reduced-motion: reduce) { .pool-wave, .busy .pool-water, .busy.pool-bar .pool-water { animation: none; } .pool-water { transition: none; } }
</style>
~~~

~~~ file: PoolRadioGroup.svelte
<!--
  PoolRadioGroup.svelte: pick one, where each choice is a little float and the picked one gets an orange center!

  <PoolRadioGroup label="Lane speed" options={['Slow', 'Medium', 'Fast']} bind:value={speed} />
  <PoolRadioGroup options={[{ value: 'k', label: 'Kids pool' }, { value: 'm', label: 'Main pool', hint: '25 m' }]} bind:value row />

  Props: options (strings, or { value, label, hint, disabled }), value (bindable), label (the group's name), row (side by side),
         name (made for you), disabled, onchange(value), class. Real radio buttons underneath: arrow keys move the choice.
-->
<script>
    let { options = [], value = $bindable(undefined), label = '', row = false, name = undefined, disabled = false, onchange = undefined, class: className = '' } = $props();
    const uid = 'plr' + Math.random().toString(36).slice(2, 8);
    const opts = $derived(options.map((o) => (typeof o === 'object' && o ? o : { value: o, label: String(o) })));
</script>

<div class="pool-radios {className}" class:row role="radiogroup" aria-labelledby={label ? uid : undefined} aria-disabled={disabled ? 'true' : undefined}>
    {#if label}<div class="pool-radios-label" id={uid}>{label}</div>{/if}
    {#each opts as o (o.value)}
        <label class="pool-radio" class:off-limits={disabled || o.disabled}>
            <input type="radio" name={name || uid} value={o.value} checked={value === o.value} disabled={disabled || o.disabled}
                onchange={() => { value = o.value; if (typeof onchange === 'function') onchange(o.value); }} />
            <span class="pool-float" aria-hidden="true"></span>
            <span class="pool-radio-text">{o.label}{#if o.hint}<small>{o.hint}</small>{/if}</span>
        </label>
    {/each}
</div>

<style>
    .pool-radios { display: flex; flex-direction: column; gap: 8px; font: 600 14px var(--pool-font, system-ui, sans-serif); color: var(--pool-ink, #0c4a6e); }
    .row { flex-direction: row; flex-wrap: wrap; align-items: center; gap: 8px 18px; }
    .row .pool-radios-label { width: 100%; }
    .pool-radios-label { font-weight: 800; color: var(--pool-deep, #075985); }
    .pool-radio { position: relative; display: inline-flex; align-items: center; gap: 9px; cursor: pointer; }
    .off-limits { opacity: 0.5; cursor: not-allowed; }
    input { position: absolute; opacity: 0; width: 22px; height: 22px; margin: 0; cursor: inherit; }
    .pool-float { flex: none; width: 22px; height: 22px; border-radius: 50%; border: 2px solid var(--pool-water-3, #00b2e3); box-sizing: border-box; background: #fff; }
    input:checked + .pool-float { background: radial-gradient(circle, var(--pool-orange, #f97316) 0 30%, transparent 33%), var(--pool-water-soft, #d6f4fc); }
    input:focus-visible + .pool-float { outline: 3px solid var(--pool-orange, #f97316); outline-offset: 2px; }
    .pool-radio-text { display: flex; flex-direction: column; }
    small { font-weight: 400; font-size: 12px; color: #4b7a94; }
</style>
