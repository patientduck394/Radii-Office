        <div class="row"><PoolSpinner /><PoolSpinner size="44px" label="Loading the lanes" showLabel /><PoolButton size="small" tone="ghost" onclick={() => (loading = !loading)}>{loading ? 'Finish loading' : 'Load again'}</PoolButton></div>
        <div class="loadcard">{#if loading}<div class="row top"><PoolSkeleton shape="circle" width="48px" /><div class="grow"><PoolSkeleton lines={3} /></div></div><PoolSkeleton shape="block" height="90px" />
            {:else}<div class="row top"><PoolAvatar name="Marina Costa" size="48px" status="online" /><div class="grow"><b>Marina Costa</b><br />Lane 4, 100 m freestyle, 58.21 seconds!</div></div>{/if}</div>
        <pre>{CODE.loading}</pre></section>

    <section><h2>PoolAvatar, PoolTooltip and PoolMenu</h2><p>Portholes with initials or a picture, water tip bubbles, and a menu of actions!</p>
        <div class="row"><PoolAvatar name="Marina Costa" status="online" /><PoolAvatar name="Kai Lindqvist" status="away" size="48px" /><PoolAvatar name="Ana" status="offline" size="56px" /><PoolAvatar name="Zoe Park" ring={false} />
            <PoolTooltip tip="Lane 1 is the fast lane!"><PoolButton size="small">Lane 1</PoolButton></PoolTooltip>
            <span>The <PoolTooltip tip="3.8 metres, with a diving board!" place="bottom">deep end</PoolTooltip> is over there!</span>
            <PoolMenu label="Lane options" items={[{ label: 'Book this lane', onselect: () => (picked = 'Booked!') }, { label: 'Share', onselect: () => (picked = 'Shared!') }, { label: 'Swap lanes', disabled: true }, { separator: true }, { label: 'Cancel booking', danger: true, onselect: () => (picked = 'Cancelled!') }]} />
            {#if picked}<b>{picked}</b>{/if}</div>
        <pre>{CODE.people}</pre></section>

    <section><h2>PoolStepper and PoolPagination</h2><p>Steps along a lane rope (click a done step to go back), and page floats!</p>
        <PoolStepper steps={[{ label: 'Pick a lane', hint: 'Lane 4' }, { label: 'Choose a time', hint: '7:00' }, 'Pay', 'Swim!']} bind:current={step} />
        <div class="row" style="margin-top:14px"><PoolButton size="small" tone="ghost" disabled={step === 0} onclick={() => step--}>Back</PoolButton><PoolButton size="small" disabled={step === 3} onclick={() => step++}>Next step</PoolButton>
            <span class="grow"></span><PoolPagination bind:page total={12} label="Results pages" /></div>
        <p class="note">Step {step + 1} of 4, page {page} of 12!</p>
        <pre>{CODE.steps}</pre></section>

    <section><h2>PoolTable and PoolStat</h2><p>A results table (click a heading to sort it) and dashboard number tiles!</p>
        <div class="grid stats"><PoolStat label="Swimmers today" value={312} change={8.4} trend={[240, 262, 255, 290, 312]} /><PoolStat label="Water temperature" value="27.5" unit="°C" change={-0.5} changeUnit="°" trend={[28.1, 28.0, 27.9, 27.6, 27.5]} /><PoolStat label="Lanes booked" value="18/24" hint="6 lanes free this hour!" /></div>
        <div style="margin-top:16px"><PoolTable caption="100 m freestyle, heat 2" columns={[{ key: 'name', label: 'Swimmer' }, { key: 'club', label: 'Club' }, { key: 'lane', label: 'Lane', align: 'right' }, { key: 'time', label: 'Time (s)', align: 'right', format: (v) => v.toFixed(2) }]} rows={RESULTS} bind:sortBy bind:sortDir /></div>
        <pre>{CODE.table}</pre></section>
</div>

