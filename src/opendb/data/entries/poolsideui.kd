~~~ file: PoolInput.svelte
<!--
  PoolInput.svelte: a text field like a clean pool tile, with a water-blue focus ring and orange for problems!

  <PoolInput label="Your name" bind:value={name} placeholder="Marina" />
  <PoolInput label="Email" type="email" bind:value={email} error={emailOk ? '' : 'That email looks unfinished!'} />
  <PoolInput label="Notes" multiline rows={4} bind:value={notes} hint="Anything the lifeguard should know" />

  Props: value (bindable), label, type ('text' default), placeholder, hint, error (an orange message; also marks it invalid),
         multiline (a text area), rows (3), required, disabled, oninput(value), class, and anything else goes on the field.
-->
<script>
    let { value = $bindable(''), label = '', type = 'text', placeholder = '', hint = '', error = '', multiline = false, rows = 3, required = false, disabled = false, oninput = undefined, class: className = '', ...rest } = $props();
    const uid = 'pli' + Math.random().toString(36).slice(2, 8);
    const said = $derived([hint ? uid + '-h' : '', error ? uid + '-e' : ''].filter(Boolean).join(' ') || undefined);
    const tell = () => { if (typeof oninput === 'function') oninput(value); };
</script>

<div class="pool-field {className}" class:bad={!!error} class:off-limits={disabled}>
    {#if label}<label for={uid}>{label}{#if required}<span class="pool-req" aria-hidden="true"> *</span>{/if}</label>{/if}
    {#if multiline}
        <textarea id={uid} {rows} {placeholder} {required} {disabled} bind:value oninput={tell} aria-invalid={error ? 'true' : undefined} aria-describedby={said} {...rest}></textarea>
    {:else}
        <input id={uid} {type} {placeholder} {required} {disabled} bind:value oninput={tell} aria-invalid={error ? 'true' : undefined} aria-describedby={said} {...rest} />
    {/if}
    {#if hint && !error}<small id={uid + '-h'} class="pool-hint">{hint}</small>{/if}
    {#if error}<small id={uid + '-e'} class="pool-error" role="alert">{error}</small>{/if}
</div>

<style>
    .pool-field { display: flex; flex-direction: column; gap: 5px; font-family: var(--pool-font, system-ui, sans-serif); color: var(--pool-ink, #0c4a6e); }
    label { font: 700 13px var(--pool-font, system-ui, sans-serif); color: var(--pool-deep, #075985); }
    .pool-req { color: var(--pool-orange-deep, #c2410c); }
    input, textarea { box-sizing: border-box; width: 100%; font: 15px var(--pool-font, system-ui, sans-serif); color: var(--pool-ink, #0c4a6e); padding: 10px 14px; border-radius: 12px;
        border: 1px solid var(--pool-line, rgba(14, 165, 233, 0.4)); background: linear-gradient(180deg, #ffffff, var(--pool-tile, #f0fdff)); box-shadow: inset 0 2px 3px rgba(7, 89, 133, 0.08); transition: box-shadow 0.15s, border-color 0.15s; }
    textarea { resize: vertical; line-height: 1.45; }
    input::placeholder, textarea::placeholder { color: #7aa7bf; }
    input:focus, textarea:focus { outline: none; border-color: var(--pool-water-3, #00b2e3); box-shadow: 0 0 0 4px rgba(34, 211, 238, 0.35), inset 0 2px 3px rgba(7, 89, 133, 0.08); }
    .bad input, .bad textarea { border-color: var(--pool-orange, #f97316); box-shadow: inset 4px 0 0 var(--pool-orange, #f97316); }
    .bad input:focus, .bad textarea:focus { box-shadow: 0 0 0 4px rgba(249, 115, 22, 0.3), inset 4px 0 0 var(--pool-orange, #f97316); }
    .pool-hint { color: #4b7a94; font-size: 12.5px; }
    .pool-error { color: var(--pool-orange-deep, #c2410c); font-size: 12.5px; font-weight: 700; }
    .off-limits { opacity: 0.55; }
</style>
