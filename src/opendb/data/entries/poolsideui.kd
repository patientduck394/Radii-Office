    <section><h2>PoolDialog and PoolToaster</h2><p>A pop-up with the water header (Escape or the haze closes it), and messages that float up like bubbles!</p>
        <div class="row"><PoolButton onclick={() => (open = true)}>Book a lane</PoolButton><PoolButton tone="ghost" onclick={() => toast('Saved your booking!')}>Water toast</PoolButton><PoolButton tone="ghost" onclick={() => toast('The pool closes in 10 minutes!', { tone: 'orange', time: 6000 })}>Orange toast</PoolButton></div>
        <PoolDialog bind:open title="Book a lane">
            <p style="margin-top:0">Which lane would you like for tomorrow morning?</p>
            <PoolTabs tabs={['Lane 1', 'Lane 2', 'Lane 3']}>{#snippet panel(i)}Lane {i + 1} is {i === 1 ? 'the medium lane' : i === 0 ? 'the fast lane' : 'the slow lane'}!{/snippet}</PoolTabs>
            {#snippet footer()}<PoolButton tone="ghost" onclick={() => (open = false)}>Cancel</PoolButton><PoolButton onclick={() => { open = false; toast('Lane booked! See you in the water!'); }}>Book it!</PoolButton>{/snippet}
        </PoolDialog>
